---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KontaktModal from '../components/KontaktModal.astro';
import VideoFenster from '../components/VideoFenster.astro';
import BildFenster from '../components/BildFenster.astro';
interface Props { titel: string; beschreibung?: string; transparent?: boolean }
const { titel, beschreibung = '', transparent = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    {beschreibung && <meta name="description" content={beschreibung} />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/Gambarino-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Header transparent={transparent} />
    <main><slot /></main>
    <Footer />
    <KontaktModal />
    <VideoFenster />
    <BildFenster />
  </body>
</html>

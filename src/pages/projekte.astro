---
// Seite „Aktuelle Projekte“ – aus Webflow nachgebaut (Stand 27.10.2026)
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/abschnitte/Seitenkopf.astro';
import Laufband from '../components/start/Laufband.astro';
import Liste from '../components/projekte/Liste.astro';
import Erklaervideo from '../components/abschnitte/Erklaervideo.astro';
import Vorteile from '../components/projekte/Vorteile.astro';
import Wissen from '../components/projekte/Wissen.astro';
import Aufruf from '../components/start/Aufruf.astro';
import FAQ from '../components/abschnitte/FAQ.astro';
import { seite } from '../data/cms';
const s = seite('projekteseite');
---
<Basis titel={s.seoTitel} beschreibung={s.seoBeschreibung}>
  <Seitenkopf bild={s.hero.bild} wort={s.hero.tagline} titel={s.hero.ueberschrift} text={s.hero.text} button={s.hero.knopf} />
  <Laufband />
  <Liste />
  <Erklaervideo ziffer="III." thema={s.video.thema} zaehler="03 / 05" wort={s.video.tagline} nummer="03" projekteButton={false} zitat={s.video.zitat} bild={s.video.bild} video={s.video.videoLink} />
  <Vorteile />
  <Wissen />
  <Aufruf />
  <FAQ ziffer="V." thema={s.fragen.thema} zaehler="05 / 05" wort={s.fragen.tagline} nummer="05" projekteButton={false}
    titel={s.fragen.ueberschrift}
    text={s.fragen.text}
    hinweis={s.fragen.hinweisText}
    fragen={s.fragen.fragen.map((x) => [x.frage, x.antwort] as [string, string])}
    nachfrageTitel={s.fragen.nachfrageTitel} nachfrageText={s.fragen.nachfrageText} />
</Basis>

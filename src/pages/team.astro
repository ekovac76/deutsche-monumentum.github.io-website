---
// Seite „Team“ – aus Webflow nachgebaut (Stand 28.10.2026)
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/abschnitte/Seitenkopf.astro';
import Laufband from '../components/start/Laufband.astro';
import Team from '../components/team/Team.astro';
import Leistungen from '../components/team/Leistungen.astro';
import Interviews from '../components/start/Interviews.astro';
import Erklaervideo from '../components/abschnitte/Erklaervideo.astro';
import Stimmen from '../components/start/Stimmen.astro';
import { seite } from '../data/cms';
const s = seite('teamseite');
---
<Basis titel={s.seoTitel} beschreibung={s.seoBeschreibung}>
  <Seitenkopf bild={s.hero.bild} wort={s.hero.tagline} titel={s.hero.ueberschrift} text={s.hero.text} button={s.hero.knopf} />
  <Laufband />
  <Team />
  <Leistungen />
  <Interviews />
  <Erklaervideo ziffer="IV." thema={s.video.thema} zaehler="04 / 05" wort={s.video.tagline} nummer="04" projekteButton={false}
    zitat={s.video.zitat} bild={s.video.bild} video={s.video.videoLink} />
  <Stimmen />
</Basis>

---
// Seite „Denkmalsuche“ – aus Webflow nachgebaut (Stand 28.10.2026)
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/abschnitte/Seitenkopf.astro';
import Laufband from '../components/start/Laufband.astro';
import Kriterien from '../components/denkmalsuche/Kriterien.astro';
import VorherNachherListe from '../components/referenzen/VorherNachherListe.astro';
import Erklaervideo from '../components/abschnitte/Erklaervideo.astro';
import Aufruf from '../components/start/Aufruf.astro';
import { seite } from '../data/cms';
const s = seite('denkmalsucheseite');
---
<Basis titel={s.seoTitel} beschreibung={s.seoBeschreibung}>
  <Seitenkopf bild={s.hero.bild} wort={s.hero.tagline} nummer="02" titel={s.hero.ueberschrift} text={s.hero.text} button={s.hero.knopf} />
  <Laufband />
  <Kriterien />
  <VorherNachherListe />
  <Erklaervideo ziffer="IV." thema={s.video.thema} zaehler="04 / 10" wort={s.video.tagline} nummer="04"
    zitat={s.video.zitat} bild={s.video.bild} video={s.video.videoLink} />
  <Aufruf />
</Basis>

---
// Seite „Denkmal & QNG erklärt“ – aus Webflow nachgebaut (Stand 28.10.2026)
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/abschnitte/Seitenkopf.astro';
import Videothek from '../components/erklaert/Videothek.astro';
import Stimmen from '../components/start/Stimmen.astro';
import { seite } from '../data/cms';
const s = seite('erklaertseite');
---
<Basis titel={s.seoTitel} beschreibung={s.seoBeschreibung}>
  <Seitenkopf bild={s.hero.bild} wort={s.hero.tagline} nummer="08" titel={s.hero.ueberschrift} text={s.hero.text} button={s.hero.knopf} />
  <Videothek />
  <Stimmen ziffer="III." thema={s.stimmen.thema} zaehler="03 / 06"
    titel={s.stimmen.ueberschrift}
    hinweisTitel={s.stimmen.hinweisTitel}
    hinweisText={s.stimmen.hinweisText} />
</Basis>

---
// Startseite – Section für Section aus Webflow nachgebaut (Stand 27.10.2026)
import Basis from '../layouts/Basis.astro';
import Hero from '../components/start/Hero.astro';
import Laufband from '../components/start/Laufband.astro';
import Zahlen from '../components/start/Zahlen.astro';
import Projekte from '../components/start/Projekte.astro';
import Video from '../components/start/Video.astro';
import Referenzen from '../components/start/Referenzen.astro';
import Interviews from '../components/start/Interviews.astro';
import Stimmen from '../components/start/Stimmen.astro';
import Aufruf from '../components/start/Aufruf.astro';
import Fragen from '../components/start/Fragen.astro';
import { seite } from '../data/cms';
const s = seite('startseite');
---
<Basis titel={s.seoTitel} beschreibung={s.seoBeschreibung} transparent testfarben>
  <Hero />
  <Laufband />
  <Zahlen />
  <Projekte />
  <Video />
  <Referenzen />
  <Interviews />
  <Stimmen />
  <Aufruf />
  <Fragen />
</Basis>

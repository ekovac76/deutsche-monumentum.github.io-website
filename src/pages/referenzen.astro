---
// Seite „Referenzen“ – aus Webflow nachgebaut (Stand 28.10.2026)
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/abschnitte/Seitenkopf.astro';
import Laufband from '../components/start/Laufband.astro';
import Zeitstrahl from '../components/referenzen/Zeitstrahl.astro';
import VorherNachherListe from '../components/referenzen/VorherNachherListe.astro';
import Aufruf from '../components/start/Aufruf.astro';
import { seite } from '../data/cms';
const s = seite('referenzenseite');
---
<Basis titel={s.seoTitel} beschreibung={s.seoBeschreibung}>
  <Seitenkopf bild={s.hero.bild} wort={s.hero.tagline} titel={s.hero.ueberschrift} text={s.hero.text} button={s.hero.knopf}
    videoDesktop={s.hero.videoDesktop} videoHandy={s.hero.videoHandy} standbild={s.hero.standbild} />
  <Laufband />
  <Zeitstrahl />
  <VorherNachherListe />
  <Aufruf />
</Basis>

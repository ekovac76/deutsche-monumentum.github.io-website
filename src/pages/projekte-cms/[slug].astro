---
// Projekt-Detailseite – 1:1 nach Webflow-Vorlage „Projekte Template“ (Daten aus Sanity bzw. src/data/projekt-details.json)
import Basis from '../../layouts/Basis.astro';
import ProjektInhalt from '../../components/projekt/ProjektInhalt.astro';
import { projektDetails as details, projekte } from '../../data/cms';

export function getStaticPaths() {
  // Entwürfe sind in Webflow nicht veröffentlicht → keine Seite
  return details.filter((p) => !p.entwurf).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
// SEO-Titel wie Webflow: „{Projekt-Subtitle} | Deutsche Monumentum“
const subtitle = projekte.find((x) => x.slug === p.slug)?.titel ?? p.name;
---
<Basis titel={`${subtitle} | Deutsche Monumentum`} beschreibung={p.heroSubline}>
  <ProjektInhalt p={p} />
</Basis>

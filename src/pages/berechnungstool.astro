---
// Seite „Berechnungstool“ – aus Webflow nachgebaut (Stand 28.10.2026)
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/abschnitte/Seitenkopf.astro';
import Laufband from '../components/start/Laufband.astro';
import Rechnerwahl from '../components/rechner/Rechnerwahl.astro';
import { seite } from '../data/cms';
const s = seite('rechnerseite');
---
<Basis titel={s.seoTitel} beschreibung={s.seoBeschreibung}>
  <Seitenkopf bild={s.hero.bild} wort={s.hero.tagline} nummer="01" fett titel={s.hero.ueberschrift} text={s.hero.text} button={s.hero.knopf} />
  <Laufband />
  <Rechnerwahl />
</Basis>

---
// Seite „Für Bauträger“ – aus Webflow nachgebaut (Stand 28.10.2026)
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/abschnitte/Seitenkopf.astro';
import Laufband from '../components/start/Laufband.astro';
import Ablauf from '../components/bautraeger/Ablauf.astro';
import Erklaervideo from '../components/abschnitte/Erklaervideo.astro';
import Aufruf from '../components/start/Aufruf.astro';
import { seite } from '../data/cms';
const s = seite('bautraegerseite');
---
<Basis titel={s.seoTitel} beschreibung={s.seoBeschreibung}>
  <Seitenkopf bild={s.hero.bild} wort={s.hero.tagline} nummer="01" titel={s.hero.ueberschrift} text={s.hero.text} button={s.hero.knopf}
    videoDesktop={s.hero.videoDesktop} videoHandy={s.hero.videoHandy} standbild={s.hero.standbild} />
  <Laufband />
  <Ablauf />
  <Erklaervideo ziffer="III." thema={s.video.thema} zaehler="03 / 04" wort={s.video.tagline} nummer="03" projekteButton={false} autorGross
    zitat={s.video.zitat} bild={s.video.bild} video={s.video.videoLink} />
  <Aufruf />
</Basis>

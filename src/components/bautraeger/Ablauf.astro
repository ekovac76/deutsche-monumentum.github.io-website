---
// Bauträger · Abschnitt II „So arbeiten wir“ (Webflow: section_layout302)
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import { seite } from '../../data/cms';
const a = seite('bautraegerseite').ablauf;
// Nummer und Pfeil ergeben sich aus der Reihenfolge. „klein“: In Webflow hat nur der erste Titel die Klasse header_4, die anderen header_3 – 1:1 übernommen
const schritte = a.schritte.map((s, i) => ({ ...s, nr: String(i + 1).padStart(2, '0'), pfeil: i < a.schritte.length - 1, klein: i === 0 }));
---
<section class="sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="II." thema={a.thema} zaehler="02 / 04" />
    <div class="kopf">
      <div class="kopf-text">
        <Tagline wort={a.tagline} nummer="02" />
        <h2 class="h1 abstand-header">{a.ueberschrift}</h2>
        <p class="einleitung">{a.text}</p>
      </div>
      <div class="hinweis-spalte">
        <div class="hinweis">
          <span class="plus" aria-hidden="true">+</span>
          <p class="text-xs">{a.hinweisText}</p>
        </div>
      </div>
    </div>
    <div class="liste">
      {schritte.map((s) => (
        <div class="item">
          <div class="zeile">
            <span class="nr">{s.nr}</span>
            {s.pfeil && <span class="pfeil" aria-hidden="true">→</span>}
          </div>
          <div class="titel-box">
            <h3 class:list={['titel', { klein: s.klein }]}>{s.titel}</h3>
          </div>
          <p class="text-small abstand-text">{s.text}</p>
        </div>
      ))}
    </div>
    <div class="button-zeile"><Button href="#kontakt" data-kontakt>{a.knopf}</Button></div>
    <Kapitelfuss />
  </div>
</section>
<style>
  .kopf{display:grid;grid-template-columns:1fr .8fr;gap:4rem}
  @media (min-width:1280px){.kopf{grid-template-columns:1fr .6fr}.kopf-text h2,.einleitung{max-width:35rem}}  /* Div Block 54 / 58 ab 1280 px */
  .kopf-text{max-width:48rem}
  .einleitung{margin:0}
  .hinweis-spalte{display:flex;flex-direction:column;align-items:flex-start}
  .hinweis{display:flex;gap:.5rem}
  .hinweis .text-xs{max-width:11rem}
  .plus{color:#8a2c26;font-size:24px;line-height:24px}
  .liste{display:grid;grid-template-columns:repeat(4,1fr);gap:4.1rem 2rem;justify-items:start;align-items:start}
  .item{display:flex;flex-direction:column;gap:1rem;width:100%;padding:0 1rem}
  .zeile{display:flex;width:100%;justify-content:space-between;align-items:center;background:var(--paper-warm)}
  .nr{font-family:var(--font-playfair);font-style:italic;font-weight:400;font-size:78px;line-height:66.3px;letter-spacing:-1.56px;color:var(--signal-orange)}
  .pfeil{font-size:22px;line-height:22px;font-weight:800;letter-spacing:-.66px;color:#8b8676}
  .titel-box{max-width:15rem;padding-bottom:1rem}
  .titel{margin:0;font-family:var(--font-sans);font-weight:700;font-size:1.3rem;line-height:1.3;color:#333}
  .titel.klein{width:100%;font-size:1.1rem;line-height:1.4;color:var(--ink-weich)}
  @media (max-width:991px){.liste{gap:4.1rem .5rem}.titel.klein{font-size:1.2rem}}
  @media (max-width:767px){.kopf{grid-template-columns:1fr}.liste{grid-template-columns:repeat(3,1fr);gap:3rem 1.1rem}}
  @media (max-width:479px){.kopf{gap:2rem}.liste{grid-template-columns:1fr;gap:1rem}}
</style>

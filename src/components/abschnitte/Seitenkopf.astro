---
// Großer Seitenkopf mit Bild (später Video), Tagline, H1, Text, Button
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
// Optional: Hintergrundvideo (Desktop 16:9, Handy 4:5) mit Standbild – ersetzt dann das Bild
interface Props { bild: string; wort?: string; nummer?: string; titel: string; text: string; button?: string; fett?: boolean; kontur?: boolean;
  videoDesktop?: string; videoHandy?: string; standbild?: string; buchstaben?: boolean }
const { bild, wort = 'Kapitel', nummer = '01', titel, text, button = 'Kontakt aufnehmen', fett = false, kontur = false,
  videoDesktop, videoHandy, standbild, buchstaben = false } = Astro.props;
---
{buchstaben && <script is:inline>document.documentElement.classList.add('js-buchstaben')</script>}
<header class="hero">
  {videoDesktop ? (
    <video class="bild" data-hero-video autoplay muted loop playsinline preload="auto" poster={standbild || bild} aria-hidden="true">
      {videoHandy && <source src={videoHandy} type="video/mp4" media="(max-width: 767px)" />}
      <source src={videoDesktop} type="video/mp4" />
    </video>
  ) : (
    <img class="bild" src={bild} alt="" fetchpriority="high" />
  )}
  <div class="schleier"></div>
  <div class="inhalt">
    <div class="box" data-buchstaben={buchstaben ? '' : undefined}>
      <Tagline wort={wort} nummer={nummer} hell />
      <h1 class:list={['h1 weiss abstand-header', { fett, kontur }]}>{titel}</h1>
      <p class="text-normal weiss abstand-text">{text}</p>
      <div class="button-zeile"><Button href="#kontakt" data-kontakt>{button}</Button></div>
    </div>
  </div>
</header>
<script>
  // Wer im Betriebssystem „Bewegung reduzieren“ eingestellt hat, sieht nur das Standbild
  if (matchMedia('(prefers-reduced-motion: reduce)').matches)
    document.querySelectorAll<HTMLVideoElement>('[data-hero-video]').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
</script>
<script>
  // Überschrift-Animation beim Laden, 1:1 nach Flux-Academy-Video „GSAP Crash Course“ (Min. 12:49–14:36):
  // Tagline: jeder Buchstabe wächst von 0 auf volle Größe, gestaffelt über 0,2 s
  // Überschrift: jeder Buchstabe gleitet von unten nach oben und blendet ein, zufällige Reihenfolge, gestaffelt über 0,2 s
  // Beides startet gleichzeitig beim Laden der Seite.
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(SplitText);

  const box = document.querySelector<HTMLElement>('[data-buchstaben]');
  if (box) {
    const zeigen = () => document.documentElement.classList.remove('js-buchstaben');
    const h1 = box.querySelector<HTMLElement>('h1');
    const tagline = box.querySelectorAll<HTMLElement>('.tagline .wort, .tagline .nr');
    if (!h1 || matchMedia('(prefers-reduced-motion: reduce)').matches) zeigen();
    else {
      const titel = SplitText.create(h1, { type: 'words,chars' });
      const tag = SplitText.create(tagline, { type: 'chars' });
      const tl = gsap.timeline({ defaults: { duration: 0.6, ease: 'back.inOut' } });
      tl.fromTo(tag.chars, { scale: 0 }, { scale: 1, stagger: { amount: 0.2 } }, 0);
      tl.fromTo(titel.chars, { autoAlpha: 0, yPercent: 100 }, { autoAlpha: 1, yPercent: 0, stagger: { amount: 0.2, from: 'random' } }, 0);
      zeigen();
    }
  }
</script>
<style>
  :global(html.js-buchstaben [data-buchstaben] h1),:global(html.js-buchstaben [data-buchstaben] .tagline){visibility:hidden}
  .hero{position:relative;overflow:hidden;background:var(--ink-weich)}
  .bild{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .schleier{position:absolute;inset:0;background:rgba(0,0,0,.15);z-index:1}
  .inhalt{position:relative;z-index:2;display:flex;align-items:center;min-height:100svh;max-height:60rem;padding:6rem max(5%, calc((100% - 80rem) / 2))}
  .box{max-width:29.8rem}
  @media (min-width:1280px){.box{max-width:39rem}}  /* max-width-medium ab 1280 px */
  .fett{font-weight:700}
  /* Webflow text-fett (Projekt-Detailseiten): zusätzlich 0,6px Kontur */
  .kontur{-webkit-text-stroke:.6px currentColor}
</style>

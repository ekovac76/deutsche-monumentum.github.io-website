---
// Großer Seitenkopf mit Bild (später Video), Tagline, H1, Text, Button
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
// Optional: Hintergrundvideo (Desktop 16:9, Handy 4:5) mit Standbild – ersetzt dann das Bild
interface Props { bild: string; wort?: string; nummer?: string; titel: string; text: string; button?: string; fett?: boolean; kontur?: boolean;
  videoDesktop?: string; videoHandy?: string; standbild?: string }
const { bild, wort = 'Kapitel', nummer = '01', titel, text, button = 'Kontakt aufnehmen', fett = false, kontur = false,
  videoDesktop, videoHandy, standbild } = Astro.props;
---
<header class="hero">
  {videoDesktop ? (
    <video class="bild" data-hero-video autoplay muted loop playsinline preload="auto" poster={standbild || bild} aria-hidden="true">
      {videoHandy && <source src={videoHandy} type="video/mp4" media="(max-width: 767px)" />}
      <source src={videoDesktop} type="video/mp4" />
    </video>
  ) : (
    <img class="bild" src={bild} alt="" fetchpriority="high" />
  )}
  <div class="schleier"></div>
  <div class="inhalt">
    <div class="box">
      <Tagline wort={wort} nummer={nummer} hell />
      <h1 class:list={['h1 weiss abstand-header', { fett, kontur }]}>{titel}</h1>
      <p class="text-normal weiss abstand-text">{text}</p>
      <div class="button-zeile"><Button href="#kontakt" data-kontakt>{button}</Button></div>
    </div>
  </div>
</header>
<script>
  // Wer im Betriebssystem „Bewegung reduzieren“ eingestellt hat, sieht nur das Standbild
  if (matchMedia('(prefers-reduced-motion: reduce)').matches)
    document.querySelectorAll<HTMLVideoElement>('[data-hero-video]').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
</script>
<style>
  .hero{position:relative;overflow:hidden;background:var(--ink-weich)}
  .bild{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .schleier{position:absolute;inset:0;background:rgba(0,0,0,.15);z-index:1}
  .inhalt{position:relative;z-index:2;display:flex;align-items:center;min-height:100svh;max-height:60rem;padding:6rem max(5%, calc((100% - 80rem) / 2))}
  .box{max-width:29.8rem}
  @media (min-width:1280px){.box{max-width:39rem}}  /* max-width-medium ab 1280 px */
  .fett{font-weight:700}
  /* Webflow text-fett (Projekt-Detailseiten): zusätzlich 0,6px Kontur */
  .kontur{-webkit-text-stroke:.6px currentColor}
</style>

---
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Randhinweis from '../Randhinweis.astro';
interface Props { ziffer: string; thema: string; zaehler: string; wort?: string; nummer: string; titel: string; text: string; hinweis: string; fragen: [string, string][]; projekteButton?: boolean; nachfrageTitel?: string; nachfrageText?: string }
const {
  ziffer, thema, zaehler, wort = 'Kapitel', nummer, titel, text, hinweis, fragen, projekteButton = true,
  nachfrageTitel = 'Noch Fragen offen?',
  nachfrageText = 'Manche Antworten passen nicht in fünf Zeilen – zum Beispiel die, was ein Investment für Ihre persönliche Steuersituation bedeutet. Genau dafür gibt es das Gespräch mit uns.',
} = Astro.props;
---
<section class="sektion" data-faq-sektion>
  <div class="sektion-innen">
    <Kapitelkopf ziffer={ziffer} thema={thema} zaehler={zaehler} />
    <div class="kopfraster">
      <div class="kopf-links">
        <Tagline wort={wort} nummer={nummer} />
        <div class="abstand-header"><h2 class="h1 schmal">{titel}</h2></div>
        <p class="text-normal schmal">{text}</p>
      </div>
      <div class="rechts"><Randhinweis text={hinweis} /></div>
    </div>
    <div class="liste">
      {fragen.map(([f, a], i) => (
        <details class="frage">
          <summary>
            <span class="links"><span class="nr">{String(i + 1).padStart(2, '0')}</span><span class="text">{f}</span></span>
            <span class="icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M16.5303 20.8839C16.2374 21.1768 15.7626 21.1768 15.4697 20.8839L7.82318 13.2374C7.62792 13.0421 7.62792 12.7255 7.82318 12.5303L8.17674 12.1768C8.372 11.9815 8.68858 11.9815 8.88384 12.1768L16 19.2929L23.1162 12.1768C23.3114 11.9815 23.628 11.9815 23.8233 12.1768L24.1768 12.5303C24.3721 12.7255 24.3721 13.0421 24.1768 13.2374L16.5303 20.8839Z" fill="currentColor"/></svg></span>
          </summary>
          <div class="antwort"><p class="text-normal">{a}</p></div>
        </details>
      ))}
    </div>
    <div class="nachfrage">
      <div class="nachfrage-kopf"><h3 class="nachfrage-titel">{nachfrageTitel}</h3></div>
      <div class="abstand-text"><p class="text-normal">{nachfrageText}</p></div>
      <div class="button-zeile knopf-abstand">
        <Button href="#kontakt" data-kontakt>Kontakt aufnehmen</Button>
        {projekteButton && <Button href="/projekte" variante="sekundaer">aktuelle Projekte</Button>}
      </div>
    </div>
    <Kapitelfuss />
  </div>
</section>
<script>
  // Animation beim Hineinscrollen:
  // oben wie die anderen Sektionen (Tagline, Überschrift Zeile für Zeile, Text; Hinweis rechts flackert verzögert wie ein Fernseher);
  // die Fragen fahren wie Perlen an der Schnur nacheinander von unten hoch, werden beim Einrasten kurz etwas größer und setzen sich.
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(SplitText, ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-faq-sektion]').forEach((sek) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const links = sek.querySelector<HTMLElement>('.kopfraster .kopf-links')!;
    const tagline = links.querySelector<HTMLElement>('.tagline');
    const titel = links.querySelector<HTMLElement>('h2')!;
    const text = links.querySelector<HTMLElement>('.text-normal');
    const hinweis = sek.querySelector<HTMLElement>('.kopfraster .rechts > *');
    const fragen = [...sek.querySelectorAll<HTMLElement>('.liste .frage')];
    gsap.set([tagline, titel, text, hinweis], { autoAlpha: 0 });
    gsap.set(fragen, { autoAlpha: 0, y: 160 });

    document.fonts.ready.then(() => {
      const zeilen = SplitText.create(titel, { type: 'lines', mask: 'lines' });
      gsap.set(titel, { autoAlpha: 1 });
      gsap.set(zeilen.lines, { yPercent: 110 });
      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power4.out' } })
        .fromTo(tagline, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.96, ease: 'power3.out' }, 0)
        .to(zeilen.lines, { yPercent: 0, duration: 1.12, stagger: 0.11 }, 0.12)
        .fromTo(text, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 1.12 }, 0.6);
      // Fragen: schnell von unten hoch, beim Einrasten kurz 103 %, dann zurück
      // während der Bewegung nichts abschneiden (Vergrößerung ragt kurz über den Rand)
      const liste = sek.querySelector<HTMLElement>('.liste');
      tl.set(liste, { overflow: 'visible' }, 0.4);
      fragen.forEach((f, i) => {
        const t = 0.45 + i * 0.12;
        tl.to(f, { autoAlpha: 1, y: 0, scale: 1.03, duration: 0.55, ease: 'power3.out' }, t)
          .to(f, { scale: 1, duration: 0.6, ease: 'power2.inOut' }, t + 0.55);
      });
      if (hinweis) {
        tl.to(hinweis, {
          keyframes: [
            { autoAlpha: 0.7, duration: 0.05 }, { autoAlpha: 0.05, duration: 0.07 },
            { autoAlpha: 0.9, duration: 0.04 }, { autoAlpha: 0.2, duration: 0.09 },
            { autoAlpha: 0.5, duration: 0.05 }, { autoAlpha: 0, duration: 0.12 },
            { autoAlpha: 1, duration: 0.04 }, { autoAlpha: 0.6, duration: 0.05 }, { autoAlpha: 1, duration: 0.08 },
          ], ease: 'none',
        }, 1.3).fromTo(hinweis, { scale: 0.97 }, { scale: 1, duration: 0.6, ease: 'power2.out' }, 1.3);
      }
      tl.set(liste, { clearProps: 'overflow' });
      ScrollTrigger.create({ trigger: sek, start: 'top 70%', once: true, onEnter: () => tl.play() });
    });
  });
</script>
<style>
  /* 1:1 nach Webflow faq2 (Div Block 54, faq2_list/_question/_answer, Div Block 33/61) */
  .kopfraster{display:grid;grid-template-columns:1fr .8fr;gap:4rem}
  .rechts{display:flex;flex-direction:column;align-items:flex-start}
  .liste{overflow:hidden;border-bottom:1px solid #000;background:var(--paper-warm)}
  .frage{background:var(--paper-warm)}
  summary{display:flex;justify-content:space-between;align-items:center;gap:1.5rem;padding:1.25rem 0;border-top:.5px solid hsl(0 0% 48.67%);background:var(--paper-warm);cursor:pointer;list-style:none}
  summary::-webkit-details-marker{display:none}
  .links{display:flex;gap:2rem}
  .nr{font-family:var(--font-mono);color:var(--signal-orange)}
  .text{font-family:var(--font-display);font-size:1.5rem;line-height:1.3;font-weight:700;color:var(--ink-weich);text-align:left}
  .icon{display:flex;flex:none;align-self:flex-start;width:2rem;height:2rem;justify-content:center;align-items:center;color:var(--ink-weich)}
  .icon svg{width:2rem;height:2rem;transition:transform .3s}
  details[open] .icon svg{transform:rotate(180deg)}
  .antwort{padding-bottom:2rem}
  .antwort p{max-width:48rem}
  /* Div Block 59: max-width-medium (29,8rem, ab 1280 px 39rem), header_3 mit Standard-h3-Abstand 20px/10px, margin_header_botton.small 1rem */
  .nachfrage{width:100%;max-width:29.8rem}
  .nachfrage-kopf{padding-bottom:1rem}
  .nachfrage-titel{margin:20px 0 10px;font-family:var(--font-sans);font-size:1.3rem;line-height:1.3;font-weight:700;color:#333}
  .knopf-abstand{padding-bottom:3rem}
  @media (min-width:1280px){.kopfraster{grid-template-columns:1fr .6fr}.schmal{max-width:35rem}.nachfrage{max-width:39rem}}
  @media (max-width:767px){.kopfraster{grid-template-columns:1fr}summary{padding:1rem 0}.icon,.icon svg{width:1.75rem;height:1.75rem}}
  @media (max-width:479px){.kopfraster{gap:2rem}.text{font-size:1.2rem}}
</style>

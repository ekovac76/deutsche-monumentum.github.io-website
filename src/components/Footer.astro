---
// Baustein „Footer“ aus dem Designsystem
import { footerNavigation, footerMehr, social, kontakt } from '../data/navigation';
const tel = (n: string) => 'tel:' + n.replace(/\s/g, '');
const icons: Record<string, string> = {
  Instagram: '<rect width="20" height="20" rx="4" fill="#111"/><rect x="5" y="5" width="10" height="10" rx="3" fill="none" stroke="#fff" stroke-width="1.6"/><circle cx="10" cy="10" r="2.3" fill="none" stroke="#fff" stroke-width="1.6"/><circle cx="13.3" cy="6.7" r=".9" fill="#fff"/>',
  LinkedIn: '<rect width="20" height="20" rx="3" fill="#111"/><rect x="5" y="8" width="2" height="7" fill="#fff"/><circle cx="6" cy="5.6" r="1.2" fill="#fff"/><path d="M9 8h1.9v1c.4-.7 1.2-1.2 2.2-1.2 1.6 0 2.4 1 2.4 2.8V15h-2v-4c0-.9-.3-1.4-1.1-1.4-.8 0-1.4.6-1.4 1.6V15H9Z" fill="#fff"/>',
  Youtube: '<rect y="3" width="20" height="14" rx="4" fill="#111"/><path d="m8 7 5 3-5 3Z" fill="#fff"/>',
};
const telIcon = '<path d="M3.6 1.5 5.7 1l1.2 3-1.6 1.2a8.4 8.4 0 0 0 4.5 4.5l1.2-1.6 3 1.2-.5 2.1c-.2.6-.7 1-1.3 1A11.8 11.8 0 0 1 2.6 2.8c0-.6.4-1.1 1-1.3Z"/>';
---
<footer>
  <div class="rahmen">
    <div class="global">
      <div class="vertikal">
        <div class="stapel">
          <div class="oben-abstand">
            <div class="top">
              <div class="links">
                <div class="logo-abstand"><a href="/"><img class="logo" src="/bilder/logo-deutsche-monumentum.png" alt="Deutsche Monumentum" width="160" height="44" loading="lazy" /></a></div>
                <div class="kontakt">
                  <p class="s"><b>Kontakt</b></p>
                  <p class="s"><a class="tel" href={tel(kontakt.mobil)}>Mobil: {kontakt.mobil} <svg viewBox="0 0 16 16" aria-hidden="true" set:html={telIcon} /></a></p>
                  <p class="s"><a class="tel" href={tel(kontakt.festnetz)}>Festnetz: {kontakt.festnetz} <svg viewBox="0 0 16 16" aria-hidden="true" set:html={telIcon} /></a></p>
                  <p class="s"><a class="u" href={`mailto:${kontakt.email}`}>{kontakt.email}</a></p>
                  <p class="s"><a class="u" href="/">{kontakt.domain}</a></p>
                </div>
              </div>
              <div class="menu">
                <div><p class="s kopf"><b>Navigation</b></p><div class="liste">{footerNavigation.map((l) => <a class="s" href={l.href}>{l.name}</a>)}</div></div>
                <div><p class="s kopf"><b>Mehr</b></p><div class="liste">{footerMehr.map((l) => <a class="s" href={l.href}>{l.name}</a>)}</div></div>
                <div><p class="s kopf"><b>Folgen Sie uns</b></p><div class="liste social">
                  {social.map((l) => <a class="s" href={l.href} target="_blank" rel="noopener"><svg viewBox="0 0 20 20" aria-hidden="true" set:html={icons[l.name]} />{l.name}</a>)}
                </div></div>
              </div>
            </div>
          </div>
          <div class="oben-abstand">
            <div class="gross" aria-hidden="true" data-wortmarke><p><span>Deutsche</span><br /><span>Monumentum</span></p></div>
          </div>
          <div class="unten-abstand">
            <div class="unten">
              <p class="s">© {new Date().getFullYear()} Eduard Kovac - Deutsche Monumentum</p>
              <div class="legal">
                <a class="s" href="/impressum">Impressum</a>
                <a class="s" href="/datenschutzerklarung">Datenschutzerklärung</a>
                <a class="s" href="/datenschutzerklarung#cookie-einstellungen">Cookie-Einstellungen</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  // Wortmarke „Deutsche Monumentum“ immer exakt auf Seitenbreite (Inhaltsbreite) – auf allen Geräten
  const box = document.querySelector<HTMLElement>('[data-wortmarke]');
  if (box) {
    const p = box.querySelector<HTMLElement>('p')!;
    const zeilen = [...p.querySelectorAll<HTMLElement>('span')];
    const anpassen = () => {
      p.style.fontSize = '100px';
      const breit = Math.max(...zeilen.map((z) => z.getBoundingClientRect().width));
      if (breit > 0) p.style.fontSize = (100 * box.clientWidth / breit) + 'px';
    };
    anpassen();
    document.fonts?.ready.then(anpassen);
    new ResizeObserver(anpassen).observe(box);
  }

  // Animation beim Hineinscrollen:
  // Logo blendet ein, Kontakt- und Menütexte klappen wie eine Abflugtafel um (gleicher Effekt wie die Fließtexte), Spalte für Spalte;
  // die Wortmarke baut sich von unten auf: Buchstaben kommen in wenigen Schwüngen – je Schwung jeder dritte Buchstabe einer Zeile
  // gleichzeitig (z. B. D, t, h), kurz nacheinander, erst „Deutsche“, dann „Monumentum“.
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { wuerfelText } from '../skripte/wuerfeltext';
  gsap.registerPlugin(SplitText, ScrollTrigger);
  const fuss = document.querySelector<HTMLElement>('footer');

  // Hover wie im Menü (Lupe): Buchstaben in Cursornähe wachsen bis 1,2 und werden leicht durchsichtig, folgen dem Cursor
  // Text in Flex-Elementen (Telefon-, Social-Links) in einen Span packen, sonst zerfallen beim Aufteilen die Abstände
  const textZiel = (el: HTMLElement) => {
    if (!getComputedStyle(el).display.includes('flex')) return el;
    const da = el.querySelector<HTMLElement>(':scope > .tx');
    if (da) return da;
    const span = document.createElement('span');
    span.className = 'tx';
    [...el.childNodes].filter((n) => n.nodeType === 3 && n.textContent!.trim()).forEach((n, i) => {
      if (i === 0) el.insertBefore(span, n);
      span.appendChild(n);
    });
    return span;
  };
  const FUSS_TEXTE = '.kontakt b, .kontakt a.tel, .kontakt a.u, .menu .kopf b, .menu a.s, .unten p.s, .legal a.s';
  const lupe = (el: HTMLElement, weite = 2.2, staerke = 0.2) => {
    el = textZiel(el);
    const chars = SplitText.create(el, { type: 'words,chars' }).chars as HTMLElement[];
    if (!chars.length) return;
    gsap.set(chars, { transformOrigin: '50% 75%' });
    const zeichen = (c: HTMLElement, f: number) =>
      gsap.to(c, { scale: 1 + staerke * f, opacity: 1 - 0.4 * f, duration: 0.45, ease: 'power3.out', overwrite: true });
    el.addEventListener('mousemove', (e) => {
      const m = chars.map((c) => { const r = c.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2, h: r.height }; });
      let n = 0;
      m.forEach((q, i) => { if (Math.abs(q.y - e.clientY) < Math.abs(m[n].y - e.clientY)) n = i; });
      chars.forEach((c, i) => {
        if (Math.abs(m[i].y - m[n].y) > m[n].h * 0.4) { zeichen(c, 0); return; }
        const nah = Math.max(0, 1 - Math.abs(e.clientX - m[i].x) / (m[i].h * weite));
        zeichen(c, nah * nah * (3 - 2 * nah));
      });
    });
    el.addEventListener('mouseleave', () => chars.forEach((c) => zeichen(c, 0)));
  };
  const hoverAn = fuss && matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Lupe erst nach der Einspiel-Animation einschalten (sonst kollidieren die Buchstaben-Aufteilungen)
  const fussLupe = () => { if (hoverAn) fuss!.querySelectorAll<HTMLElement>(FUSS_TEXTE).forEach((el) => lupe(el)); };
  const wortmarkeLupe = () => { if (hoverAn && box) lupe(box.querySelector<HTMLElement>('p')!, 0.6, 0.08); };

  if (fuss && matchMedia('(prefers-reduced-motion: reduce)').matches) document.fonts.ready.then(fussLupe);
  if (fuss && box && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const logo = fuss.querySelector<HTMLElement>('.logo-abstand');
    const spalten = [...fuss.querySelectorAll<HTMLElement>('.kontakt, .menu > div')];
    const zeilen = [...box.querySelectorAll<HTMLElement>('span')];
    gsap.set([logo, ...zeilen].filter(Boolean), { autoAlpha: 0 });
    gsap.set(fuss.querySelectorAll('.social svg, .tel svg'), { autoAlpha: 0 });
    let tl: gsap.core.Timeline | null = null;
    const bauen = () => {
      tl = gsap.timeline({ paused: true });
      if (logo) tl.fromTo(logo, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.96, ease: 'power3.out' }, 0);
      let textEnde = 0;
      spalten.forEach((sp, i) => {
        sp.querySelectorAll<HTMLElement>(FUSS_TEXTE).forEach((el) => { textEnde = Math.max(textEnde, wuerfelText(tl!, textZiel(el), 0.1 + i * 0.12)); });
      });
      tl.to(fuss.querySelectorAll('.social svg, .tel svg'), { autoAlpha: 1, duration: 0.6, ease: 'power2.out', stagger: 0.05 }, 0.5);
      let t = 0.2;
      const splits: SplitText[] = [];
      zeilen.forEach((z) => {
        const sp = SplitText.create(z, { type: 'chars', mask: 'chars' });
        splits.push(sp);
        const chars = sp.chars as HTMLElement[];
        gsap.set(z, { autoAlpha: 1 });
        gsap.set(chars, { yPercent: 110 });
        [0, 1, 2].forEach((g) => {
          tl!.to(chars.filter((_, i) => i % 3 === g), { yPercent: 0, duration: 1.0, ease: 'power4.out' }, t);
          t += 0.16;
        });
        t += 0.1;
      });
      // danach wieder normaler Text (Masken würden sonst Buchstabenkanten anschneiden)
      tl.call(() => { splits.forEach((sp) => sp.revert()); wortmarkeLupe(); });
      tl.call(fussLupe, [], Math.max(tl.duration(), textEnde + 0.1));
      ScrollTrigger.create({ trigger: fuss, start: 'top 75%', once: true, onEnter: () => tl!.play() });
    };
    document.fonts.ready.then(bauen);
  }
</script>

<style>
  /* 1:1 nach Webflow footer16 (footer16_component, Div Block 52/43/44, padding-vertical/-large/-medium) */
  footer{background:var(--paper-warm);padding:2rem 0 1rem;color:var(--ink-stumpf)}
  .rahmen{padding:2rem 2rem 0}
  .global{padding:0 max(5%, calc((100% - 80rem) / 2))}
  /* Webflow: padding-xxlarge/-large/-medium existieren nur als Kombi ohne Höhenwerte → kein Innenabstand */
  .stapel{display:flex;flex-direction:column;gap:1.5rem}
  .oben-abstand{padding-top:1rem}
  .s{margin:0;font-size:.9rem;line-height:1.5;color:var(--ink-stumpf)}
  .s b{font-weight:700}
  .top{display:grid;grid-template-columns:.75fr 1fr;column-gap:8vw;row-gap:1rem;align-items:start}
  .links{display:flex;flex-direction:column}
  .logo-abstand{padding-bottom:2rem}
  .logo{display:block;height:44px;width:auto}
  .kontakt{display:flex;flex-direction:column;gap:.4rem}
  .tel{display:inline-flex;align-items:center;gap:6px;text-decoration:none}
  .tel svg{width:12px;height:12px}
  .tel :global(path){fill:var(--ink-stumpf)}
  .u{text-decoration:none;padding-bottom:1px;background:linear-gradient(currentColor,currentColor) 0 100%/100% 1px no-repeat} /* Linie statt Unterstreichung, damit sie beim Hover-Effekt erhalten bleibt */
  .menu{display:grid;grid-template-columns:1fr 1fr 1fr;column-gap:2rem;row-gap:1rem;align-items:start}
  .kopf{margin-bottom:.5rem}
  .liste{display:flex;flex-direction:column;align-items:flex-start}
  .liste a{padding:.5rem 0;text-decoration:none}
  .liste a:hover{color:var(--ink-tinte)}
  .social a{display:flex;align-items:center;gap:.75rem}
  .social svg{width:20px;height:20px;flex:none}
  .gross{overflow:hidden;width:100%}
  .gross p{margin:0;font-family:Poppins,var(--font-sans);font-weight:900;font-size:11.5vw;line-height:1;letter-spacing:-.04em;color:var(--ink-weich);white-space:nowrap}
  .gross span{display:inline-block}
  .unten{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem}
  .legal{display:flex;justify-content:center;gap:1.5rem}
  .legal a{font-size:.875rem;text-decoration:underline;text-underline-offset:2px}
  @media (max-width:991px){
    .top{grid-template-columns:1fr;row-gap:4rem}
  }
  @media (max-width:767px){
    .top{row-gap:3rem}
    .menu{column-gap:1.5rem}
    .unten{flex-wrap:nowrap;align-items:flex-start}
    .legal{flex-direction:column;gap:1rem}
  }
  @media (max-width:479px){
    .menu{grid-template-columns:1fr 1fr;row-gap:2.5rem}
    .unten{flex-direction:column-reverse}
  }
</style>

---
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Randhinweis from '../Randhinweis.astro';
import Videovorschau from '../Videovorschau.astro';
import Sterne from '../Sterne.astro';
import { seite } from '../../data/cms';
const s = seite('startseite').interviews;
---
<section class="sektion" id="interviews-sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="VI." thema={s.thema} zaehler="06 / 10" />
    <div class="kopfraster">
      <div class="links">
        <Tagline wort={s.tagline} nummer="06" />
        <div class="abstand-header"><h2 class="h1 schmal">{s.ueberschrift}</h2></div>
        <p class="schmal einleitung">{s.text}</p>
      </div>
      <div class="rechts"><Randhinweis text={s.hinweisText} /></div>
    </div>
    <div class="karten">
      {s.karten.map((i) => (
        <article class="karte">
          <div class="buehne"><Videovorschau bild={i.bild} alt={`Interview mit ${i.name}`} /></div>
          <div class="inhalt">
            <div class="sterne-zeile"><Sterne /></div>
            <div class="zitat"><p class="text-small">{i.zitat}</p></div>
            <div class="kunde-abstand">
              <div class="kunde">
                <span class="foto"><img src={i.foto} alt={i.name} loading="lazy" /></span>
                <div>
                  <p class="text-small name">{i.name}</p>
                  <p class="text-small">{i.rolle}</p>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    <Kapitelfuss />
  </div>
</section>
<script>
  // Animation beim Hineinscrollen:
  // links wie im Hero (Tagline, Überschrift Zeile für Zeile, dann Text); Hinweis rechts flackert verzögert auf wie ein Fernseher;
  // Karten als Welle nacheinander: Videobild öffnet sich wie in der Erklärvideo-Sektion (Rechteck aus der Mitte, Einblenden von 0,
  // Bild zoomt zurück), darunter Sterne, Zitat und Kunde steigen auf.
  import { gsap } from 'gsap';
  import { wuerfelText } from '../../skripte/wuerfeltext';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(SplitText, ScrollTrigger);

  const sek = document.getElementById('interviews-sektion');
  if (sek && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const links = sek.querySelector<HTMLElement>('.links')!;
    const tagline = links.querySelector<HTMLElement>('.tagline');
    const titel = links.querySelector<HTMLElement>('h2')!;
    const text = links.querySelector<HTMLElement>('.einleitung');
    const hinweis = sek.querySelector<HTMLElement>('.rechts > *');
    const karten = [...sek.querySelectorAll<HTMLElement>('.karte')];
    const buehnen = karten.map((k) => k.querySelector<HTMLElement>('.buehne')!);
    const inhalte = karten.map((k) => k.querySelectorAll<HTMLElement>('.sterne-zeile, .zitat, .kunde-abstand'));
    gsap.set([tagline, titel, text, hinweis, ...buehnen], { autoAlpha: 0 });
    inhalte.forEach((i) => gsap.set(i, { autoAlpha: 0, y: 30 }));

    // rechteckige Öffnung aus der Mitte, reicht am Ende über den Rand (Schatten und Eckwinkel gehen mit auf)
    const oeffnen = (b: HTMLElement) => {
      const off = { k: 0 };
      const zeichne = () => {
        const w = b.offsetWidth, h = b.offsetHeight, rand = 80;
        const hw = (w / 2 + rand) * off.k, hh = (h / 2 + rand) * off.k;
        b.style.clipPath = `polygon(${w / 2 - hw}px ${h / 2 - hh}px,${w / 2 + hw}px ${h / 2 - hh}px,${w / 2 + hw}px ${h / 2 + hh}px,${w / 2 - hw}px ${h / 2 + hh}px)`;
      };
      const bild = b.querySelector<HTMLElement>('.bild');
      return gsap.timeline({ onStart: zeichne })
        .fromTo(b, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.6, ease: 'power1.out' }, 0)
        .to(off, { k: 1, duration: 1.0, ease: 'power2.out', onUpdate: zeichne, onComplete: () => { b.style.clipPath = ''; } }, 0)
        .fromTo(bild, { scale: 1.2 }, { scale: 1, duration: 1.2, ease: 'power2.out' }, 0);
    };

    document.fonts.ready.then(() => {
      const zeilen = SplitText.create(titel, { type: 'lines', mask: 'lines' });
      gsap.set(titel, { autoAlpha: 1 });
      gsap.set(zeilen.lines, { yPercent: 110 });
      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power4.out' } })
        .fromTo(tagline, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.96, ease: 'power3.out' }, 0)
        .to(zeilen.lines, { yPercent: 0, duration: 1.12, stagger: 0.11 }, 0.12);
      wuerfelText(tl, text, 0.12);
      // Welle: Karte für Karte versetzt
      karten.forEach((_, i) => {
        const t = 0.5 + i * 0.22;
        tl.add(oeffnen(buehnen[i]), t)
          .to(inhalte[i], { autoAlpha: 1, y: 0, duration: 1.0, ease: 'back.out(1.6)', stagger: 0.08 }, t + 0.35);
      });
      if (hinweis) {
        tl.to(hinweis, {
          keyframes: [
            { autoAlpha: 0.7, duration: 0.05 }, { autoAlpha: 0.05, duration: 0.07 },
            { autoAlpha: 0.9, duration: 0.04 }, { autoAlpha: 0.2, duration: 0.09 },
            { autoAlpha: 0.5, duration: 0.05 }, { autoAlpha: 0, duration: 0.12 },
            { autoAlpha: 1, duration: 0.04 }, { autoAlpha: 0.6, duration: 0.05 }, { autoAlpha: 1, duration: 0.08 },
          ], ease: 'none',
        }, 1.3).fromTo(hinweis, { scale: 0.97 }, { scale: 1, duration: 0.6, ease: 'power2.out' }, 1.3);
      }
      ScrollTrigger.create({ trigger: sek, start: 'top 70%', once: true, onEnter: () => tl.play() });
    });
  }
</script>
<style>
  /* Webflow Div Block 54: 1fr .8fr (ab 1280 px 1fr .6fr), Abstand 4rem; links max-width-large, Überschrift/Text Div Block 58 (ab 1280 px max. 35rem);
     rechts divright 3 Copy Copy: Hinweis oben links in der rechten Spalte */
  .kopfraster{display:grid;grid-template-columns:1fr .8fr;gap:4rem}
  .links{max-width:48rem}
  .einleitung{margin:0}
  .rechts{display:flex;flex-direction:column;justify-content:flex-start;align-items:flex-start;width:100%;height:100%}
  @media (min-width:1280px){.kopfraster{grid-template-columns:1fr .6fr}.schmal{max-width:35rem}}
  .karten{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
  /* testimonial53_card-content + testimonial12_rating-wrapper, margin_text_botton, margin-top.margin-small, testimonial12_client */
  .inhalt{padding:2rem 0}
  .sterne-zeile{display:flex;padding-bottom:2rem}
  .zitat{padding-bottom:3rem}
  .kunde-abstand{padding-bottom:3rem}
  .kunde{display:flex;align-items:center;gap:.8rem;text-align:left}
  .foto{flex:none;overflow:hidden;width:3.5rem;height:3.5rem;border:1px solid hsl(0 0% 76%);border-radius:100%;box-shadow:0 10px 20px 0 rgba(0,0,0,.2)}
  .foto img{width:100%;height:100%;object-fit:cover;object-position:50% -15%;background:var(--paper-tief)}
  .name{font-weight:700}
  @media (max-width:991px){.karten{grid-template-columns:1fr 1fr}}
  @media (max-width:767px){.kopfraster{grid-template-columns:1fr}.karten{grid-template-columns:1fr}}
  @media (max-width:479px){.kopfraster{gap:2rem}}
  @media (max-width:767px){.inhalt{padding:1.5rem}.kunde{flex-direction:column;align-items:flex-start;gap:0}.foto{margin-bottom:1rem}}
</style>

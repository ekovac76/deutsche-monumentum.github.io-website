---
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kennzahlkarte from '../Kennzahlkarte.astro';
import { seite } from '../../data/cms';
// 1:1 aus Webflow – alle vier Karten tragen dort „01 · Systeme“ (siehe offene Punkte)
const l = seite('startseite').leistungen;
---
<section class="sektion">
  <div class="sektion-innen">
    <div class="raster">
      <div>
        <Tagline wort={l.tagline} nummer="03" />
        <h2 class="h2 abstand-header">{l.ueberschrift}</h2>
        <p class="text-normal abstand-text">{l.text}</p>
        <div class="button-zeile">
          <Button href={l.knopf.link}>{l.knopf.text}</Button>
          <Button href={l.knopf2.link} variante="sekundaer">{l.knopf2.text}</Button>
        </div>
      </div>
      <div class="liste">
        {l.kacheln.map((k) => <Kennzahlkarte zahl="01" neben="Systeme" titel={k.titel} text={k.text} />)}
      </div>
    </div>
  </div>
</section>
<style>
  .raster{display:grid;grid-template-columns:.5fr 1fr;gap:2rem;align-items:start}
  .liste{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  @media (max-width:991px){.raster{grid-template-columns:1fr;gap:3rem}}
  @media (max-width:479px){.liste{grid-template-columns:1fr}}
</style>

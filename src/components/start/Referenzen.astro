---
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Randhinweis from '../Randhinweis.astro';
import Karussell from '../Karussell.astro';
import Referenzkachel from '../Referenzkachel.astro';
import { seite } from '../../data/cms';
const r = seite('startseite').referenzen;
---
<section class="sektion ueberlauf">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="V." thema={r.thema} zaehler="05 / 10" />
    <div class="kopfraster">
      <div>
        <Tagline wort={r.tagline} nummer="05" />
        <h2 class="h1 abstand-header">{r.ueberschrift}</h2>
        <p class="text-normal">{r.text}</p>
      </div>
      <div class="rechts">
        <Randhinweis nummer="02" titel={r.hinweisTitel} text={r.hinweisText} />
      </div>
    </div>
    <Karussell label="Referenzprojekte">
      {r.kacheln.map((k) => <div class="slide"><Referenzkachel jahr={k.jahr} href={k.link} titel={k.titel} text={k.text} bild={k.bild} zeile={k.zeile} /></div>)}
    </Karussell>
    <Kapitelfuss />
  </div>
</section>
<style>
  .ueberlauf{overflow:hidden}
  /* product5_slide: 2rem rechts (1,5rem ab Handy), Slides gleich hoch */
  .slide{padding-right:2rem;align-self:stretch}
  @media (max-width:767px){.slide{padding-right:1.5rem}}
  .kopfraster{display:grid;grid-template-columns:1fr .55fr;gap:5rem;align-items:start}
  .rechts{display:flex;justify-content:flex-end}
  @media (max-width:991px){.kopfraster{grid-template-columns:1fr;gap:2rem}.rechts{justify-content:flex-start}}
</style>

---
import FAQ from '../abschnitte/FAQ.astro';
import { seite } from '../../data/cms';
const f = seite('startseite').fragen;
---
<FAQ ziffer="IX." thema={f.thema} zaehler="09 / 10" wort={f.tagline} nummer="09"
  titel={f.ueberschrift}
  text={f.text}
  hinweis={f.hinweisText}
  fragen={f.fragen.map((x) => [x.frage, x.antwort] as [string, string])}
  nachfrageTitel={f.nachfrageTitel} nachfrageText={f.nachfrageText} />

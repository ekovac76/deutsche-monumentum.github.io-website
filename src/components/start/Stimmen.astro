---
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Randhinweis from '../Randhinweis.astro';
import Karussell from '../Karussell.astro';
import Sterne from '../Sterne.astro';
import { seite, kundenstimmen } from '../../data/cms';
const st = seite('startseite').stimmen;
interface Props { ziffer?: string; thema?: string; zaehler?: string; titel?: string; hinweisTitel?: string; hinweisText?: string }
const {
  ziffer = 'VII.', thema = st.thema, zaehler = '07 / 10',
  titel = st.ueberschrift,
  hinweisTitel = st.hinweisTitel,
  hinweisText = st.hinweisText,
} = Astro.props;
---
<section class="sektion ueberlauf" data-stimmen-sektion data-eigen>
  <div class="sektion-innen">
    <Kapitelkopf ziffer={ziffer} thema={thema} zaehler={zaehler} />
    <div class="kopfraster">
      <div class="links">
        <Tagline wort={st.tagline} nummer="07" />
        <h2 class="h1 abstand-header">{titel}</h2>
        <p class="text-normal">{st.text}</p>
      </div>
      <div class="rechts"><Randhinweis nummer="03" titel={hinweisTitel} text={hinweisText} /></div>
    </div>
    <Karussell label="Kundenstimmen">
      {kundenstimmen.map((s) => (
        <div class="slide">
          <article class="stimme">
            <div class="oben">
              <div class="sterne-zeile"><Sterne /></div>
              <h3 class="h4">{s.titel}</h3>
            </div>
            <div class="zitat"><p class="text-small">{s.text}</p></div>
            <div class="kunde">
              <span class="foto"><img src={s.foto} alt={s.name} loading="lazy" /></span>
              <div>
                <p class="text-small name">{s.name}</p>
                <p class="text-small">{s.rolle}</p>
              </div>
            </div>
          </article>
        </div>
      ))}
    </Karussell>
    <Kapitelfuss />
  </div>
</section>
<script>
  // Animation beim Hineinscrollen:
  // links wie im Hero (Tagline, Überschrift Zeile für Zeile, dann Text);
  // Hinweis oben rechts: zeitverzögert, flackert unregelmäßig auf wie ein alter Fernseher und bleibt dann stehen (zieht den Blick);
  // Kundenstimmen: steigen nacheinander wie eine Welle von unten auf. (gleiches Prinzip wie Projekte-Sektion)
  import { gsap } from 'gsap';
  import { wuerfelText } from '../../skripte/wuerfeltext';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(SplitText, ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-stimmen-sektion]').forEach((sek) => {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  {
    const links = sek.querySelector<HTMLElement>('.links')!;
    const tagline = links.querySelector<HTMLElement>('.tagline');
    const titel = links.querySelector<HTMLElement>('h2')!;
    const text = links.querySelector<HTMLElement>('.text-normal');
    const hinweis = sek.querySelector<HTMLElement>('.rechts > *');
    const karten = [...sek.querySelectorAll<HTMLElement>('[data-karussell] .spur > * > *')];
    gsap.set([tagline, titel, text, hinweis], { autoAlpha: 0 });
    gsap.set(karten, { autoAlpha: 0, y: 140 });

    document.fonts.ready.then(() => {
      const zeilen = SplitText.create(titel, { type: 'lines', mask: 'lines' });
      gsap.set(titel, { autoAlpha: 1 });
      gsap.set(zeilen.lines, { yPercent: 110 });
      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power4.out' } })
        .fromTo(tagline, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.96, ease: 'power3.out' }, 0)
        .to(zeilen.lines, { yPercent: 0, duration: 1.12, stagger: 0.11 }, 0.12)
      // Welle: Karten steigen nacheinander auf, schwingen leicht über
        .to(karten, { autoAlpha: 1, y: 0, duration: 1.0, ease: 'back.out(1.6)', stagger: 0.09 }, 0.45)
        ;
      if (hinweis) {
        // Fernseher-Flackern: unregelmäßig an und aus, dann ganz da
        tl.set(hinweis, { autoAlpha: 0 }, 1.3)
          .to(hinweis, {
            keyframes: [
              { autoAlpha: 0.7, duration: 0.05 }, { autoAlpha: 0.05, duration: 0.07 },
              { autoAlpha: 0.9, duration: 0.04 }, { autoAlpha: 0.2, duration: 0.09 },
              { autoAlpha: 0.5, duration: 0.05 }, { autoAlpha: 0, duration: 0.12 },
              { autoAlpha: 1, duration: 0.04 }, { autoAlpha: 0.6, duration: 0.05 }, { autoAlpha: 1, duration: 0.08 },
            ], ease: 'none',
          }, 1.3)
          .fromTo(hinweis, { scale: 0.97 }, { scale: 1, duration: 0.6, ease: 'power2.out' }, 1.3);
      }
      wuerfelText(tl, text, 0.12);
      ScrollTrigger.create({ trigger: sek, start: 'top 70%', once: true, onEnter: () => tl.play() });

    });
  }
  });
</script>
<style>
  .ueberlauf{overflow:hidden}
  .kopfraster{display:grid;grid-template-columns:1fr .8fr;gap:4rem;align-items:start}
  .rechts{display:flex;justify-content:flex-end}
  /* 1:1 nach Webflow testimonial12: Slide 3rem rechts (Tablet 0 + 2,5rem Außenabstand), Inhalt Spalte mit 2rem Abstand,
     Sterne-Zeile 2rem unten, Kunde: Foto 3,5rem (Rand, Schatten) + Name halbfett, 0,8rem Abstand */
  .slide{padding-right:3rem}
  .stimme{display:flex;width:100%;flex-direction:column;gap:2rem}
  .sterne-zeile{display:flex;padding-bottom:2rem}
  .zitat{display:flex;flex-direction:column;align-items:flex-start}
  .kunde{display:flex;align-items:center;gap:.8rem;text-align:left}
  .foto{flex:none;overflow:hidden;width:3.5rem;height:3.5rem;border:1px solid hsl(0 0% 76%);border-radius:100%;box-shadow:0 10px 20px 0 rgba(0,0,0,.2)}
  .foto img{width:100%;height:100%;object-fit:cover;object-position:50% -15%;background:var(--paper-tief)}
  .name{font-weight:700}  /* Name steht in Webflow in <strong> */
  @media (max-width:991px){.slide{padding-right:0;margin-right:2.5rem}}
  @media (max-width:767px){.kunde{flex-direction:column;align-items:flex-start;gap:0}.foto{margin-bottom:1rem}}
  @media (max-width:767px){.kopfraster{grid-template-columns:1fr;gap:2rem}.rechts{justify-content:flex-start}}
</style>

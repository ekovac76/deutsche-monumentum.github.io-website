---
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Randhinweis from '../Randhinweis.astro';
import Karussell from '../Karussell.astro';
import Sterne from '../Sterne.astro';
import { seite, kundenstimmen } from '../../data/cms';
const st = seite('startseite').stimmen;
interface Props { ziffer?: string; thema?: string; zaehler?: string; titel?: string; hinweisTitel?: string; hinweisText?: string }
const {
  ziffer = 'VII.', thema = st.thema, zaehler = '07 / 10',
  titel = st.ueberschrift,
  hinweisTitel = st.hinweisTitel,
  hinweisText = st.hinweisText,
} = Astro.props;
---
<section class="sektion ueberlauf">
  <div class="sektion-innen">
    <Kapitelkopf ziffer={ziffer} thema={thema} zaehler={zaehler} />
    <div class="kopfraster">
      <div>
        <Tagline wort={st.tagline} nummer="07" />
        <h2 class="h1 abstand-header">{titel}</h2>
        <p class="text-normal">{st.text}</p>
      </div>
      <div class="rechts"><Randhinweis nummer="03" titel={hinweisTitel} text={hinweisText} /></div>
    </div>
    <Karussell label="Kundenstimmen">
      {kundenstimmen.map((s) => (
        <div class="slide">
          <article class="stimme">
            <div class="oben">
              <div class="sterne-zeile"><Sterne /></div>
              <h3 class="h4">{s.titel}</h3>
            </div>
            <div class="zitat"><p class="text-small">{s.text}</p></div>
            <div class="kunde">
              <span class="foto"><img src={s.foto} alt={s.name} loading="lazy" /></span>
              <div>
                <p class="text-small name">{s.name}</p>
                <p class="text-small">{s.rolle}</p>
              </div>
            </div>
          </article>
        </div>
      ))}
    </Karussell>
    <Kapitelfuss />
  </div>
</section>
<style>
  .ueberlauf{overflow:hidden}
  .kopfraster{display:grid;grid-template-columns:1fr .8fr;gap:4rem;align-items:start}
  .rechts{display:flex;justify-content:flex-end}
  /* 1:1 nach Webflow testimonial12: Slide 3rem rechts (Tablet 0 + 2,5rem Außenabstand), Inhalt Spalte mit 2rem Abstand,
     Sterne-Zeile 2rem unten, Kunde: Foto 3,5rem (Rand, Schatten) + Name halbfett, 0,8rem Abstand */
  .slide{padding-right:3rem}
  .stimme{display:flex;width:100%;flex-direction:column;gap:2rem}
  .sterne-zeile{display:flex;padding-bottom:2rem}
  .zitat{display:flex;flex-direction:column;align-items:flex-start}
  .kunde{display:flex;align-items:center;gap:.8rem;text-align:left}
  .foto{flex:none;overflow:hidden;width:3.5rem;height:3.5rem;border:1px solid hsl(0 0% 76%);border-radius:100%;box-shadow:0 10px 20px 0 rgba(0,0,0,.2)}
  .foto img{width:100%;height:100%;object-fit:cover;object-position:50% -15%;background:var(--paper-tief)}
  .name{font-weight:700}  /* Name steht in Webflow in <strong> */
  @media (max-width:991px){.slide{padding-right:0;margin-right:2.5rem}}
  @media (max-width:767px){.kunde{flex-direction:column;align-items:flex-start;gap:0}.foto{margin-bottom:1rem}}
  @media (max-width:767px){.kopfraster{grid-template-columns:1fr;gap:2rem}.rechts{justify-content:flex-start}}
</style>

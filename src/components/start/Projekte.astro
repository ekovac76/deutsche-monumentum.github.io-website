---
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Randhinweis from '../Randhinweis.astro';
import Projektkarte from '../Projektkarte.astro';
import Karussell from '../Karussell.astro';
import { projekte, seite } from '../../data/cms';
const s = seite('startseite').projekte;
---
<section class="sektion" id="projekte-sektion" data-eigen>
  <div class="sektion-innen">
    <Kapitelkopf ziffer="III." thema={s.thema} zaehler="03 / 10" />
    <div class="kopfraster">
      <div class="links">
        <Tagline wort={s.tagline} nummer="03" />
        <h2 class="h1 abstand-header">{s.ueberschrift}</h2>
        <p class="text-normal">{s.text}</p>
      </div>
      <div class="rechts">
        <Randhinweis nummer="01" titel={s.hinweisTitel} text={s.hinweisText} />
      </div>
    </div>
    <Karussell label="Aktuelle Projekte" maxBreite={302}>
      {projekte.map((p) => <div><Projektkarte {...p} /></div>)}
    </Karussell>
    <Kapitelfuss />
  </div>
</section>
<script>
  // Animation beim Hineinscrollen:
  // links wie im Hero (Tagline, Überschrift Zeile für Zeile, dann Text);
  // Hinweis oben rechts: zeitverzögert, flackert unregelmäßig auf wie ein alter Fernseher und bleibt dann stehen (zieht den Blick);
  // Projektkarten: steigen nacheinander wie eine Welle von unten auf.
  import { gsap } from 'gsap';
  import { wuerfelText, wuerfelHinweis } from '../../skripte/wuerfeltext';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(SplitText, ScrollTrigger);

  const sek = document.getElementById('projekte-sektion');
  if (sek && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const links = sek.querySelector<HTMLElement>('.links')!;
    const tagline = links.querySelector<HTMLElement>('.tagline');
    const titel = links.querySelector<HTMLElement>('h2')!;
    const text = links.querySelector<HTMLElement>('.text-normal');
    const hinweis = sek.querySelector<HTMLElement>('.rechts > *');
    const karten = [...sek.querySelectorAll<HTMLElement>('[data-karussell] .spur > * > *')];
    gsap.set([tagline, titel, text, hinweis], { autoAlpha: 0 });
    gsap.set(karten, { autoAlpha: 0, y: 140 });
    let welleFertig = false;

    document.fonts.ready.then(() => {
      const zeilen = SplitText.create(titel, { type: 'lines', mask: 'lines' });
      gsap.set(titel, { autoAlpha: 1 });
      gsap.set(zeilen.lines, { yPercent: 110 });
      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power4.out' } })
        .fromTo(tagline, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.96, ease: 'power3.out' }, 0)
        .to(zeilen.lines, { yPercent: 0, duration: 1.12, stagger: 0.11 }, 0.12)
      // Welle: Karten steigen nacheinander auf, schwingen leicht über
        .to(karten, { autoAlpha: 1, y: 0, duration: 1.0, ease: 'back.out(1.6)', stagger: 0.09 }, 0.45)
        .call(() => { welleFertig = true; });
      // Hinweis wie eine Abflugtafel (gleicher Effekt wie die Fließtexte)
      wuerfelHinweis(tl, hinweis, 1.3);
      wuerfelText(tl, text, 0.12);
      ScrollTrigger.create({ trigger: sek, start: 'top 70%', once: true, onEnter: () => tl.play() });

      // Hover auf den Projektkarten: Lupen-Effekt wie im Menü – Buchstaben des Titels in Cursornähe wachsen bis 1,2
      // und werden leicht durchsichtig (bei zweizeiligem Titel wirkt sie in der Zeile, die dem Cursor am nächsten ist)
      if (matchMedia('(hover: hover)').matches) {
        karten.forEach((k) => {
          const h = k.querySelector<HTMLElement>('.titel');
          if (!h) return;
          const chars = SplitText.create(h, { type: 'words,chars' }).chars as HTMLElement[];
          gsap.set(chars, { transformOrigin: '50% 75%' });
          const zeichen = (c: HTMLElement, f: number) =>
            gsap.to(c, { scale: 1 + 0.2 * f, opacity: 1 - 0.4 * f, duration: 0.45, ease: 'power3.out', overwrite: true });
          k.addEventListener('mousemove', (e) => {
            const gr = parseFloat(getComputedStyle(h).fontSize);
            const radius = gr * 2.2;
            const mitte = chars.map((c) => { const r = c.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; });
            // Zeile wählen, die dem Cursor senkrecht am nächsten ist; dort wirkt die Lupe waagrecht
            let zeileY = mitte[0]?.y ?? 0;
            mitte.forEach((m) => { if (Math.abs(m.y - e.clientY) < Math.abs(zeileY - e.clientY)) zeileY = m.y; });
            chars.forEach((c, i) => {
              const m = mitte[i];
              if (Math.abs(m.y - zeileY) > gr * 0.5) { zeichen(c, 0); return; }
              const nah = Math.max(0, 1 - Math.abs(e.clientX - m.x) / radius);
              zeichen(c, nah * nah * (3 - 2 * nah));
            });
          });
          // Karte hebt sich edel hervor: wächst ganz leicht und hebt sich an
          const heben = (an: boolean) => {
            if (!welleFertig) return;
            gsap.to(k, { scale: an ? 1.03 : 1, y: an ? -6 : 0, duration: 0.9, ease: 'power3.out', overwrite: 'auto' });
          };
          k.addEventListener('mouseenter', () => heben(true));
          k.addEventListener('mouseleave', () => { chars.forEach((c) => zeichen(c, 0)); heben(false); });
        });
      }
    });
  }
</script>
<style>
  .kopfraster{display:grid;grid-template-columns:1fr .55fr;gap:5rem;align-items:start}
  .rechts{display:flex;justify-content:flex-end}
  @media (max-width:991px){.kopfraster{grid-template-columns:1fr;gap:2rem}.rechts{justify-content:flex-start}}
</style>

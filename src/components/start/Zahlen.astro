---
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Kennzahlkarte from '../Kennzahlkarte.astro';
const zahlen = [
  { zahl: '+ 1.5K', titel: 'Verkaufte Wohnungen', text: 'Profitieren Sie von unserer langjährigen Erfahrung im Immobilienverkauf als Kapitalanlage. Zufriedene Kunden garantieren Qualität.' },
  { zahl: '+ 8K', titel: 'Bestandskunden', text: 'Mehr als 8000 zufriedene Kunden - Qualität für Kapitalanleger und Vorteil für Bauträger. Schneller Verkauf großer Denkmalprojekte.' },
  { zahl: '+ 140M €', titel: 'Gesparte Steuern', text: 'In den letzten 30 Jahren haben wir über 140 Mio. Euro Steuern für unsere Kunden gespart und in ihr Privatvermögen überführt.' },
  { zahl: '100%', titel: 'Nachhaltigkeit', text: 'Unsere Tätigkeit revitalisiert alte Industriebrachen, Kasernen und leerstehende Häuser zu neuem, attraktivem Wohnraum. Sanierung als nachhaltiger Weg zur Schaffung von Wohnraum.' },
];
---
<section class="sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="II." thema="Über uns / In Zahlen" zaehler="02 / 10" />
    <div class="komponente">
      <div class="kopfraster">
        <div>
          <Tagline nummer="02" />
          <h2 class="h1 abstand-header">Steuern sparen, Vermögen aufbauen: Deutsche Monumentum macht’s möglich!</h2>
        </div>
      </div>
      <div class="raster">
        <div>
          <p class="text-normal abstand-text">Mit den hochwertigen Denkmalimmobilien der Marke „Deutsche Monumentum“ erhalten Sie herausragende Kapitalanlagen an vielversprechenden Wachstumsstandorten. Als erfahrene Experten für exklusive Immobilien sind wir seit über 30 Jahren die führende Marke in Deutschland.</p>
          <div class="button-zeile"><Button href="/team">Mehr Erfahren!</Button></div>
        </div>
        <div class="kacheln">
          {zahlen.map((z) => <Kennzahlkarte {...z} />)}
        </div>
      </div>
    </div>
    <Kapitelfuss />
  </div>
</section>
<style>
  /* Webflow: layout245_component (Abstand 2rem), Überschrift in linker Hälfte (layout245_content 1fr 1fr),
     Text 0.65fr / Kacheln 1fr (Grid), Kacheln 2 Spalten mit 1rem Abstand (Grid 2.is-zahlen-kacheln) */
  .komponente{display:flex;flex-direction:column;gap:2rem}
  .kopfraster{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start}
  .raster{display:grid;grid-template-columns:.65fr 1fr;gap:3rem}
  .kacheln{display:grid;grid-template-columns:1fr 1fr;grid-auto-rows:1fr;align-items:stretch;gap:1rem}
  /* Webflow-Breakpoint „large“ (ab 1280 px): Überschrift-Spalte 1fr/.75fr, Text/Kacheln 1fr/1fr */
  @media (min-width:1280px){.kopfraster{grid-template-columns:1fr .75fr}.raster{grid-template-columns:1fr 1fr}}
  @media (max-width:991px){.kopfraster{grid-template-columns:1fr;gap:2rem 3rem}.raster{grid-template-columns:1fr}.kacheln{gap:3rem}}
  @media (max-width:767px){.kopfraster{gap:1.25rem}}
  @media (max-width:479px){.komponente{gap:3rem}.kacheln{grid-template-columns:1fr;gap:2rem}}
</style>

---
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Kennzahlkarte from '../Kennzahlkarte.astro';
import { seite } from '../../data/cms';
const z = seite('startseite').zahlen;
---
<section class="sektion" id="zahlen-sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="II." thema={z.thema} zaehler="02 / 10" />
    <div class="raster">
      <div class="links">
        <div class="kopf">
          <Tagline wort={z.tagline} nummer="02" />
          <h2 class="h1 abstand-header">{z.ueberschrift}</h2>
        </div>
        <p class="text-normal abstand-text">{z.text}</p>
        <div class="button-zeile"><Button href={z.knopf.link}>{z.knopf.text}</Button></div>
      </div>
      <div class="kacheln">
        {z.kacheln.map((k) => <Kennzahlkarte zahl={k.zahl} titel={k.titel} text={k.text} zahlen />)}
      </div>
    </div>
    <Kapitelfuss />
  </div>
</section>
<script>
  // Animation beim Hineinscrollen:
  // links wie im Hero (Tagline, Überschrift Zeile für Zeile, dann Text und Knopf);
  // rechts die Karten wie beim Solitär (nach Flux-Video ab 22:43): Stapel fliegt von unten herein
  // (y 200 %, leicht gedreht −5°/5°), dann werden die Karten nacheinander auf ihre Plätze verteilt und drehen sich gerade.
  // Hover: Titel mit Lupen-Effekt wie im Menü (folgt dem Cursor); Pfeil hebt sich und wächst (nach Video ab 29:00), beim Verlassen rückwärts.
  // Zusätzlich wächst die Karte sanft (3,5 %) und hebt sich leicht an.
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(SplitText, ScrollTrigger);

  const sek = document.getElementById('zahlen-sektion');
  const leise = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (sek && !leise) {
    const links = sek.querySelector<HTMLElement>('.links')!;
    const tagline = links.querySelector<HTMLElement>('.tagline');
    const titel = links.querySelector<HTMLElement>('h2')!;
    const rest = links.querySelectorAll<HTMLElement>('.abstand-text, .button-zeile');
    const karten = [...sek.querySelectorAll<HTMLElement>('.kacheln > .karte')];
    const breit = matchMedia('(min-width: 992px)').matches;
    let ausgeteilt = !breit;
    gsap.set([tagline, titel, ...rest], { autoAlpha: 0 });
    gsap.set(karten, { autoAlpha: 0 });

    document.fonts.ready.then(() => {
      const zeilen = SplitText.create(titel, { type: 'lines', mask: 'lines' });
      gsap.set(titel, { autoAlpha: 1 });
      gsap.set(zeilen.lines, { yPercent: 110 });
      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power4.out' } })
        .fromTo(tagline, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.96, ease: 'power3.out' }, 0)
        .to(zeilen.lines, { yPercent: 0, duration: 1.12, stagger: 0.11 }, 0.12)
        .fromTo(rest, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 1.12, stagger: 0.12 }, 0.6);

      if (breit && karten.length > 1) {
        // Stapel liegt auf dem Platz der letzten Karte (unten rechts)
        const ziel = karten[karten.length - 1].getBoundingClientRect();
        const dreh = [-5, 5, -5, 5];
        karten.forEach((k, i) => {
          const r = k.getBoundingClientRect();
          gsap.set(k, { x: ziel.left - r.left, y: ziel.top - r.top, rotation: dreh[i % 4], zIndex: karten.length - i, autoAlpha: 1, yPercent: 200 });
        });
        // 1. Stapel fliegt von unten herein, Karten leicht versetzt
        tl.to(karten, { yPercent: 0, duration: 0.9, ease: 'power2.out', stagger: 0.06 }, 0.15);
        // 2. Austeilen beginnt, bevor der Stapel ganz zur Ruhe kommt – durchgehende Bewegung ohne Stopp
        tl.to(karten.slice(0, -1), { x: 0, y: 0, rotation: 0, duration: 1.0, ease: 'power3.out', stagger: 0.14 }, 0.75);
        tl.to(karten[karten.length - 1], { rotation: 0, duration: 1.0, ease: 'power3.out' }, 0.75 + 0.14 * (karten.length - 1));
        tl.set(karten, { zIndex: 'auto' });
        tl.call(() => { ausgeteilt = true; });
      } else {
        tl.fromTo(karten, { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 1.12, stagger: 0.12 }, 0.3);
      }
      ScrollTrigger.create({ trigger: sek, start: 'top 70%', once: true, onEnter: () => tl.play() });

      // Hover auf den Karten
      if (matchMedia('(hover: hover)').matches) {
        karten.forEach((k) => {
          const pfeil = k.querySelector<HTMLElement>('.pfeil');
          if (!pfeil) return;
          // Titel: Lupen-Effekt wie im Menü – Buchstaben in Cursornähe wachsen bis 1,2 und werden leicht durchsichtig
          const h = k.querySelector<HTMLElement>('.h4');
          const chars = h ? (SplitText.create(h, { type: 'words,chars' }).chars as HTMLElement[]) : [];
          gsap.set(chars, { transformOrigin: '50% 75%' });
          const zeichen = (c: HTMLElement, f: number) =>
            gsap.to(c, { scale: 1 + 0.2 * f, opacity: 1 - 0.4 * f, duration: 0.45, ease: 'power3.out', overwrite: true });
          k.addEventListener('mousemove', (e) => {
            if (!h) return;
            const radius = parseFloat(getComputedStyle(h).fontSize) * 2.2;
            chars.forEach((c) => {
              const r = c.getBoundingClientRect();
              const nah = Math.max(0, 1 - Math.abs(e.clientX - (r.left + r.width / 2)) / radius);
              zeichen(c, nah * nah * (3 - 2 * nah));
            });
          });
          const hv = gsap.timeline({ paused: true })
            .to(pfeil, { scale: 1.2, yPercent: -40, duration: 0.6, ease: 'circ.inOut' }, 0);
          // Karte wächst sanft und hebt sich leicht an – wie durch einen Wassertropfen betrachtet
          const lupe = (an: boolean) => {
            if (!ausgeteilt) return;
            gsap.to(k, { scale: an ? 1.035 : 1, y: an ? -6 : 0, duration: 0.9, ease: 'power3.out', overwrite: 'auto' });
          };
          k.addEventListener('mouseenter', () => { hv.timeScale(1).play(); lupe(true); });
          k.addEventListener('mouseleave', () => { hv.timeScale(1.5).reverse(); lupe(false); chars.forEach((c) => zeichen(c, 0)); });
        });
      }
    });
  }
</script>
<style>
  /* Ursprünglich Webflow layout245 (Überschrift oben über ganzer Breite, darunter Text | Kacheln).
     Änderung Eduard 06.11.: Kacheln nach oben – Oberkante der Kacheln auf Höhe der Tagline („Kapitel · Nº 02“);
     Überschrift, Text und Knopf stehen links, Kacheln rechts. Mobil unverändert untereinander. */
  .kopf{margin-bottom:2rem}
  .raster{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
  .kacheln{display:grid;grid-template-columns:1fr 1fr;grid-auto-rows:1fr;align-items:stretch;gap:1rem}
  @media (min-width:1280px){.kacheln{gap:2rem}}
  @media (max-width:991px){.raster{grid-template-columns:1fr}.kacheln{gap:3rem}}
  @media (max-width:479px){.kopf{margin-bottom:3rem}.kacheln{grid-template-columns:1fr;gap:2rem}}
</style>

---
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Kennzahlkarte from '../Kennzahlkarte.astro';
import { seite } from '../../data/cms';
const z = seite('startseite').zahlen;
---
<section class="sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="II." thema={z.thema} zaehler="02 / 10" />
    <div class="raster">
      <div>
        <div class="kopf">
          <Tagline wort={z.tagline} nummer="02" />
          <h2 class="h1 abstand-header">{z.ueberschrift}</h2>
        </div>
        <p class="text-normal abstand-text">{z.text}</p>
        <div class="button-zeile"><Button href={z.knopf.link}>{z.knopf.text}</Button></div>
      </div>
      <div class="kacheln">
        {z.kacheln.map((k) => <Kennzahlkarte zahl={k.zahl} titel={k.titel} text={k.text} zahlen />)}
      </div>
    </div>
    <Kapitelfuss />
  </div>
</section>
<style>
  /* Ursprünglich Webflow layout245 (Überschrift oben über ganzer Breite, darunter Text | Kacheln).
     Änderung Eduard 06.11.: Kacheln nach oben – Oberkante der Kacheln auf Höhe der Tagline („Kapitel · Nº 02“);
     Überschrift, Text und Knopf stehen links, Kacheln rechts. Mobil unverändert untereinander. */
  .kopf{margin-bottom:2rem}
  .raster{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start}
  .kacheln{display:grid;grid-template-columns:1fr 1fr;grid-auto-rows:1fr;align-items:stretch;gap:1rem}
  @media (min-width:1280px){.kacheln{gap:2rem}}
  @media (max-width:991px){.raster{grid-template-columns:1fr}.kacheln{gap:3rem}}
  @media (max-width:479px){.kopf{margin-bottom:3rem}.kacheln{grid-template-columns:1fr;gap:2rem}}
</style>

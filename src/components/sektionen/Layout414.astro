---
// Relume „Layout 414“ (uncommon-components-2 / section_layout414) im Designsystem:
// oben zwei Spalten (links Tagline + Überschrift, rechts Text + zwei Knöpfe),
// darunter zwei Bildreihen über die ganze Breite, die sich beim Scrollen gegenläufig verschieben.
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
interface Bild { src: string; alt: string; caption?: string; innen?: string }
interface Knopf { text: string; link: string }
interface Props {
  ziffer: string; thema: string; zaehler: string; tagline?: string; nummer: string;
  ueberschrift: string; text: string; knopf?: Knopf; knopf2?: Knopf;
  reihe1: Bild[]; reihe2: Bild[];
}
const { ziffer, thema, zaehler, tagline = 'Kapitel', nummer, ueberschrift, text, knopf, knopf2, reihe1, reihe2 } = Astro.props;
const istKontakt = (l?: string) => l === '#kontakt';
---
<section class="sektion l414">
  <div class="sektion-innen">
    <Kapitelkopf ziffer={ziffer} thema={thema} zaehler={zaehler} />
    <div class="raster">
      <div>
        <Tagline wort={tagline} nummer={nummer} />
        <h2 class="h1">{ueberschrift}</h2>
      </div>
      <div>
        <p class="text-normal">{text}</p>
        {(knopf || knopf2) && (
          <div class="button-zeile knoepfe">
            {knopf && <Button href={knopf.link} {...(istKontakt(knopf.link) ? { 'data-kontakt': true } : {})}>{knopf.text}</Button>}
            {knopf2 && <Button href={knopf2.link} variante="sekundaer" {...(istKontakt(knopf2.link) ? { 'data-kontakt': true } : {})}>{knopf2.text}</Button>}
          </div>
        )}
      </div>
    </div>
  </div>
  <div class="reihen" data-l414>
    <div class="reihe" data-richtung="1">
      {reihe1.map((b) => <div class="bild"><img src={b.src} alt={b.alt} loading="lazy" />{b.innen && <img class="innen" src={b.innen} alt="" aria-hidden="true" loading="lazy" />}{b.caption && <span class="caption">{b.caption}</span>}</div>)}
    </div>
    <div class="reihe" data-richtung="-1">
      {reihe2.map((b) => <div class="bild"><img src={b.src} alt={b.alt} loading="lazy" />{b.innen && <img class="innen" src={b.innen} alt="" aria-hidden="true" loading="lazy" />}{b.caption && <span class="caption">{b.caption}</span>}</div>)}
    </div>
  </div>
  <div class="sektion-innen fuss-innen"><Kapitelfuss /></div>
</section>
<style>
  .l414{overflow:hidden}
  /* Relume: zwei Spalten, Abstand 5rem (lg) / 3rem (md), oben ausgerichtet */
  .raster{display:grid;grid-template-columns:1fr 1fr;gap:2rem 5rem;align-items:start}
  .knoepfe{margin-top:2rem}
  /* Bildreihen: volle Breite, Bilder 30vw (Handy 40vw), Format 4:3, Abstand 1rem */
  .reihen{position:relative;display:flex;flex-direction:column;gap:1rem;width:100%}
  /* Schleier links und rechts – wie beim Karussell der Startseite (4 % Breite, Seitengrund → transparent) */
  .reihen::before,.reihen::after{content:"";position:absolute;top:0;bottom:0;width:4%;z-index:2;pointer-events:none}
  .reihen::before{left:0;background:linear-gradient(to right,var(--paper-warm),transparent)}
  .reihen::after{right:0;background:linear-gradient(to left,var(--paper-warm),transparent)}
  .reihe{display:flex;flex-wrap:nowrap;justify-content:center;gap:1rem;will-change:transform}
  /* Bildstil wie in den Projektkarten: eckig, feiner Rahmen, Bildunterschrift in Mono weiß unten links */
  .bild{position:relative;flex:none;width:30vw;border:1px solid var(--ink-blass);overflow:hidden}
  .bild img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;background:var(--paper-tief)}
  /* Innenbild liegt deckungsgleich über dem Außenbild und wird weich ein- und ausgeblendet */
  .bild .innen{position:absolute;inset:0;height:100%;opacity:0;transition:opacity 1.4s ease}
  .bild.innen-an .innen{opacity:1}
  .caption{position:absolute;left:5%;right:5%;bottom:10%;z-index:1;font-family:var(--font-mono);color:#fff;font-size:12px;line-height:19px}
  .fuss-innen{padding-top:4rem}
  @media (max-width:991px){.raster{gap:2rem 3rem}.fuss-innen{padding-top:3rem}}
  @media (max-width:767px){.raster{grid-template-columns:1fr}.bild{width:40vw}.reihen::before,.reihen::after{display:none}}
</style>
<script>
  // Gegenläufiges Verschieben beim Scrollen (wie Relume: Reihe 1 −2 % → 5 %, Reihe 2 2 % → −5 %)
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-l414]').forEach((box) => {
    if (ruhig) return;
    const reihen = box.querySelectorAll<HTMLElement>('.reihe');
    let geplant = false;
    const setzen = () => {
      geplant = false;
      const r = box.getBoundingClientRect();
      const h = window.innerHeight;
      const p = Math.min(1, Math.max(0, (h - r.top) / (h + r.height)));
      reihen.forEach((reihe) => {
        const x = reihe.dataset.richtung === '1' ? -2 + 7 * p : 2 - 7 * p;
        reihe.style.transform = `translateX(${x}%)`;
      });
    };
    const anstossen = () => { if (!geplant) { geplant = true; requestAnimationFrame(setzen); } };
    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', anstossen);
    setzen();
  });

  // Innenbild-Wechsel:
  // Maus aufs Bild → Innenbild blendet langsam ein.
  // Jede neue Mausbewegung (nach kurzer Ruhe) → wechselt langsam zum jeweils anderen Bild (innen ↔ außen).
  // Während einer durchgehenden Bewegung wird nur einmal gewechselt; Zittern unter 8 px zählt nicht.
  // Maus weg → zurück zum Außenbild. Klicken bzw. Antippen (auch am Handy) → wechselt ebenfalls.
  const mitMaus = window.matchMedia('(hover: hover)').matches;
  document.querySelectorAll<HTMLElement>('[data-l414] .bild').forEach((bild) => {
    if (!bild.querySelector('.innen')) return;
    let timer = 0, x = 0, y = 0, ruht = false;
    bild.style.cursor = 'pointer';
    bild.addEventListener('click', () => bild.classList.toggle('innen-an'));
    if (!mitMaus) return;
    const bewegt = () => { ruht = false; clearTimeout(timer); timer = window.setTimeout(() => { ruht = true; }, 400); };
    bild.addEventListener('pointerenter', (e) => { x = e.clientX; y = e.clientY; bild.classList.add('innen-an'); bewegt(); });
    bild.addEventListener('pointermove', (e) => {
      if (Math.hypot(e.clientX - x, e.clientY - y) < 8) return;
      x = e.clientX; y = e.clientY;
      if (ruht) bild.classList.toggle('innen-an');
      bewegt();
    });
    bild.addEventListener('pointerleave', () => { clearTimeout(timer); bild.classList.remove('innen-an'); });
  });
</script>

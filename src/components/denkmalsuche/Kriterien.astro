---
// Denkmalsuche · Abschnitt III „Kriterien“ (Webflow: section_layout436 + layout16_item-list)
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import { bilder } from '../../data/bilder';
import { seite } from '../../data/cms';
const k = seite('denkmalsucheseite').kriterien;
const [b1, b2, b3, b4] = k.bilder;
---
<section class="sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="III." thema={k.thema} zaehler="03 / 06" />
    <div class="inhalt">
      <div class="links">
        <div class="rahmen r1">
          <img class="bild" src={b1} alt="" loading="lazy" />
          <img class="ecke ul" src={bilder.eckeUntenLinks} alt="" />
          <img class="ecke ol" src={bilder.eckeObenLinks} alt="" />
          <img class="ecke ur" src={bilder.eckeUntenRechts} alt="" />
        </div>
        <div class="rahmen r2">
          <img class="bild" src={b2} alt="" loading="lazy" />
          <img class="ecke ul" src={bilder.eckeUntenLinks} alt="" />
          <img class="ecke ur" src={bilder.eckeUntenRechts} alt="" />
          <img class="ecke ol" src={bilder.eckeObenLinks} alt="" />
        </div>
        <div class="rahmen r3">
          <img class="bild" src={b3} alt="" loading="lazy" />
          <img class="ecke ur" src={bilder.eckeUntenRechts} alt="" />
          <img class="ecke ol" src={bilder.eckeObenLinks} alt="" />
          <img class="ecke ul" src={bilder.eckeUntenLinks} alt="" />
        </div>
      </div>
      <div class="rechts">
        <div class="rahmen r4">
          <img class="bild" src={b4} alt="" loading="lazy" />
          <img class="ecke ul" src={bilder.eckeUntenLinks} alt="" />
          <img class="ecke ur" src={bilder.eckeUntenRechts} alt="" />
          <img class="ecke ol" src={bilder.eckeObenLinks} alt="" />
        </div>
        <div class="text">
          <Tagline wort={k.tagline} nummer="03" />
          <h2 class="h1 abstand-header">{k.ueberschrift}</h2>
          <p class="text-normal abstand-text">{k.text}</p>
          <ul class="liste abstand-text">
            {k.kriterien.map((k) => (
              <li class="item">
                <img class="icon" src={k.icon} alt="" loading="lazy" />
                <p class="text-normal">{k.text}</p>
              </li>
            ))}
          </ul>
          <div class="button-zeile"><Button href="#kontakt" data-kontakt>{k.knopf}</Button></div>
        </div>
      </div>
    </div>
    <Kapitelfuss />
  </div>
</section>
<style>
  .inhalt{display:grid;grid-template-columns:1fr 1fr;gap:4rem}
  .links{display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start}
  .rechts{display:flex;flex-direction:column;align-items:flex-end}
  .rahmen{position:relative;overflow:hidden;width:100%;padding:.25rem;box-shadow:0 30px 60px 0 rgba(0,0,0,.2)}
  .r2{max-width:13.8rem}
  .r3{max-width:22.1rem}
  .r4{max-width:20rem}
  .bild{width:100%;height:100%;aspect-ratio:1/1;object-fit:cover;box-shadow:0 30px 60px 0 rgba(0,0,0,.2);background:var(--paper-tief)}
  .ecke{position:absolute;max-width:none}
  .ul{left:0;bottom:0}
  .ur{right:0;bottom:0}
  .ol{left:2px;top:2px;z-index:2}
  .text{margin-top:5rem}
  .liste{display:grid;grid-template-columns:1fr;gap:1.5rem;margin-top:0;padding:.5rem 0;list-style:none}
  .item{display:flex;gap:1rem}
  .icon{flex:none;align-self:flex-start}
  @media (max-width:991px){.text{margin-top:4.5rem}}
  @media (max-width:767px){.inhalt{grid-template-columns:1fr;gap:3rem}.text{margin-top:3rem}}
</style>

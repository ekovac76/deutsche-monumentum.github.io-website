---
// Baustein „Referenzkachel“: Jahreszahl + Pfeil, Titel, Text, gerahmtes Bild mit Bildzeile
interface Props { jahr: string; titel: string; text: string; bild: string; zeile: string; href?: string }
const { jahr, titel, text, bild, zeile, href = '/referenzen' } = Astro.props;
---
<a class="kachel" href={href}>
  <div class="jahr"><span>{jahr}</span><span class="pfeil">→</span></div>
  <h3 class="h4">{titel}</h3>
  <p class="text-small">{text}</p>
  <div class="rahmen">
    <img src={bild} alt={titel} loading="lazy" />
    <span class="ecke ol" aria-hidden="true"></span>
    <span class="ecke ur" aria-hidden="true"></span>
    <span class="zeile">{zeile}</span>
  </div>
</a>
<style>
  .kachel{display:flex;flex-direction:column;gap:1rem;height:100%;text-decoration:none;color:inherit}
  .jahr{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:.75rem;border-bottom:1px solid var(--karte-linie);font-family:var(--font-display);font-size:2rem;color:var(--ink-weich)}
  .pfeil{font-family:var(--font-sans);font-size:1rem;transition:transform .2s}
  .kachel:hover .pfeil{transform:translateX(4px)}
  .rahmen{position:relative;margin-top:auto;padding:.75rem;border:1px solid var(--referenz-bildrahmen);background:var(--referenz-bildgrund)}
  .rahmen img{width:100%;aspect-ratio:10/12;object-fit:cover;background:var(--paper-tief)}
  .ecke{position:absolute;width:12px;height:12px;border-color:var(--ink-weich);border-style:solid}
  .ol{top:-1px;left:-1px;border-width:2px 0 0 2px}
  .ur{bottom:-1px;right:-1px;border-width:0 2px 2px 0}
  .zeile{display:block;padding-top:.6rem;font-family:var(--font-mono);font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:var(--ink-stumpf)}
</style>

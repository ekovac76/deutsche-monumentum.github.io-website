---
// Baustein „Referenzkachel“ – 1:1 nach Webflow (product5_item → Product 2 → referenz_card):
// Jahreszahl (Playfair kursiv 78px) mit Pfeil, Titel + Text (Div Block 22), Bild in „divimg“
// (0,5rem Innenabstand, Eckwinkel-Grafiken am Außenrand, Schatten, 12px Rundung), Bildzeile unten links.
// Beim Darüberfahren zoomt das Bild (Motion-Layer: .referenz_card:hover img → scale 1.07).
import { bilder } from '../data/bilder';
interface Props { jahr: string; titel: string; text: string; bild: string; zeile: string; href?: string }
const { jahr, titel, text, bild, zeile, href = '/referenzen' } = Astro.props;
---
<a class="link" href={href}>
  <div class="produkt">
    <div class="karte">
      <div class="kopf">
        <span class="jahr">{jahr}</span>
        <span class="pfeil-box"><span class="pfeil">→</span></span>
      </div>
      <div class="texte">
        <div class="titel-box"><h3 class="h4">{titel}</h3></div>
        <div class="text-box"><p class="text-small">{text}</p></div>
      </div>
      <div class="divimg">
        <img class="foto" src={bild} alt={titel} loading="lazy" />
        <img class="ecke ol" src={bilder.eckeObenLinks} alt="" aria-hidden="true" />
        <img class="ecke ur" src={bilder.eckeUntenRechtsKarte} alt="" aria-hidden="true" />
        <span class="zeile">{zeile}</span>
      </div>
    </div>
  </div>
</a>
<style>
  .link{display:block;overflow:visible;width:100%;text-decoration:none;color:inherit}
  .produkt{display:flex;overflow:visible;width:100%;max-width:296px;flex-direction:column;justify-content:flex-start;align-items:flex-start;gap:16px}
  .karte{display:flex;overflow:visible;width:100%;height:auto;flex-direction:column;justify-content:space-between;align-items:flex-start;gap:1.5rem}
  .kopf{display:flex;width:100%;justify-content:space-between;align-items:center;background:var(--paper-warm)}
  .jahr{font-family:var(--font-playfair);font-style:italic;font-weight:400;font-size:78px;line-height:66.3px;letter-spacing:-1.56px;color:var(--signal-orange)}
  .pfeil-box{display:flex;flex-direction:column;justify-content:center}
  .pfeil{font-size:22px;line-height:22px;font-weight:800;letter-spacing:-.66px;color:#8b8676}
  .texte{display:flex;max-width:14rem;padding-left:.5rem;flex-direction:column}
  .titel-box{padding-bottom:1rem}
  .text-box{display:flex;width:100%;max-width:200px;flex-direction:column}
  .divimg{position:relative;display:flex;overflow:hidden;width:100%;max-width:270px;padding:.5rem;flex-direction:column;justify-content:center;align-items:flex-start;gap:1rem;border-radius:12px;box-shadow:0 30px 60px 0 rgba(0,0,0,.2)}
  .foto{position:static;width:100%;aspect-ratio:1/1;object-fit:cover;box-shadow:0 30px 60px 0 rgba(0,0,0,.2);background:var(--paper-tief)}
  .ecke{position:absolute;max-width:none}
  .ol{left:5px;top:2px}
  .ur{right:3px;bottom:4px}
  .zeile{position:absolute;left:19px;bottom:13px;font-family:var(--font-mono);font-size:10px;color:#fff}
  .karte img{transition:transform .8s cubic-bezier(.16,1,.3,1)}
  .karte:hover img{transform:scale(1.07)}
  @media (min-width:1280px){.karte{height:100%}}
</style>

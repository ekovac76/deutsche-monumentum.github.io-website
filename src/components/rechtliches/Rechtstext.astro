---
// Rechtstexte (Impressum, Datenschutz) – 1:1 nach Webflow (section_content23 · max-width-medium · heading_1 text-fett · header_3 · text_normal)
interface Props { html: string }
const { html } = Astro.props;
---
<section class="sektion">
  <div class="sektion-innen oben">
    <div class="text" set:html={html} />
  </div>
</section>
<style>
  .oben{padding-top:calc(var(--nav-height) + 4rem)}
  @media (max-width:991px){.oben{padding-top:calc(var(--nav-height) + 3rem)}}
  .text{width:100%;max-width:29.8rem;overflow-wrap:anywhere}
  .text :global(h1){margin:0 0 10px;font-family:var(--font-display);font-weight:700;font-size:2.8rem;line-height:1.2;color:var(--ink-weich);-webkit-text-stroke:.6px currentColor}
  @media (min-width:1280px){.text :global(h1){line-height:1.3}}
  @media (max-width:479px){.text :global(h1){font-size:2.2rem}}
  .text :global(h2),.text :global(h3){margin:20px 0 10px;font-family:var(--font-sans);font-size:1.3rem;line-height:1.3;font-weight:700;color:#333}
  .text :global(p),.text :global(li){margin:0 0 10px;font-size:1rem;line-height:1.5;color:var(--ink-stumpf)}
  .text :global(ul),.text :global(ol){margin:0 0 10px;padding-left:40px}
  .text :global(a){color:inherit;text-decoration:underline}
</style>

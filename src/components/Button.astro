---
// Baustein „Button“ aus dem Designsystem: primaer | sekundaer | klein
interface Props { href: string; variante?: 'primaer' | 'sekundaer' | 'klein'; pfeil?: boolean; [key: string]: any }
const { href, variante = 'primaer', pfeil = variante !== 'klein', ...rest } = Astro.props;
---
<a class={`btn ${variante}`} href={href} {...rest}>
  <slot />
  {pfeil && (
    <span class="pfeil" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 10 10 2M3.5 2H10v6.5" /></svg>
    </span>
  )}
</a>

<style>
  .btn{display:inline-flex;align-items:center;gap:10px;border-radius:var(--radius-pill);text-decoration:none;font-family:var(--font-sans);font-size:13px;line-height:21.7px;font-weight:500;letter-spacing:-0.07px;cursor:pointer;white-space:nowrap;transition:transform .2s ease, box-shadow .2s ease}
  .btn:hover{transform:translateY(-1px)}
  .pfeil{display:flex;width:16px;height:16px;justify-content:center;align-items:center}
  .pfeil path{fill:none;stroke:currentColor;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
  .primaer{background:var(--signal-orange-alt);color:var(--paper-bone);padding:var(--button-pad-y) var(--button-pad-x);box-shadow:var(--shadow-primary);border:1px solid transparent}
  .sekundaer{background:transparent;color:var(--ink-tinte-button);padding:14px 18px 14px 22px;border:1px solid var(--outline-dunkel);box-shadow:var(--shadow-secondary);font-family:Helvetica,Arial,sans-serif;font-weight:400}
  .sekundaer .pfeil path{stroke-width:1.1}
  .klein{background:var(--signal-orange);color:var(--paper-bone);padding:8.5px 16px}
</style>

---
// Baustein „Videovorschau“ – 1:1 nach Webflow:
// Standard = layout2_lightbox: Bild 1:1 ohne Rahmen, Schatten 0 30px 60px, Eckwinkel-Grafiken oben links/unten rechts,
//   Play-Symbol + „Video“ (JetBrains Mono 28px) mittig, senkrechter Schriftzug unten rechts. Kein Abdunkeln
//   (die Overlay-Farbvariable existiert in Webflow nicht mehr → durchsichtig).
// rahmen = testimonial53_lightbox (Interviews): 0,25rem heller Rand, Schatten auf Rahmen und Bild.
import { bilder } from '../data/bilder';
// format: Seitenverhältnis des Bildes – überall 4/3 (Eduard 06.11.; in Webflow 1/1)
// vorschau: optionales kurzes MP4 (4:3, ohne Ton) – läuft, solange die Maus auf dem Bild ist (Handy: sobald es im Bild ist);
//   Einstieg über Schwarz, danach wieder das Deckbild.
interface Props { bild: string; alt?: string; video?: string; rahmen?: boolean; quadrat?: boolean; label?: string; format?: string; vorschau?: string }
const { bild, alt = '', video = '', rahmen = false, quadrat = false, label = 'DEUTSCHE MONUMENTUM', format = '4/3', vorschau } = Astro.props;
---
<button class:list={['vorschau', { rahmen: rahmen || quadrat }]} data-vorschau={vorschau ? '' : undefined} type="button" data-video={video} aria-label="Video abspielen">
  <img class="bild" src={bild} alt={alt} loading="lazy" style={`aspect-ratio:${format}`} />
  {vorschau && <video class="vorschauvideo" src={vorschau} muted loop playsinline preload="none" aria-hidden="true"></video>}
  {vorschau && <span class="blende" aria-hidden="true"></span>}
  <span class="play" aria-hidden="true">
    <img src={bilder.videoPlay} alt="" />
    <span class="play-text">Video</span>
  </span>
  <span class="schleier" aria-hidden="true"></span>
  <span class="ecke ol" aria-hidden="true"></span>
  <span class="marke" aria-hidden="true"><span>{label}</span></span>
  <span class="ecke ur" aria-hidden="true"></span>
</button>
<style>
  .vorschau{position:relative;display:flex;flex-direction:column;justify-content:center;align-items:center;width:100%;max-width:100%;padding:0;border:0;background:none;overflow:visible;cursor:pointer;box-shadow:0 30px 60px 0 rgba(0,0,0,.2);font:inherit}
  .bild{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;object-position:50% 50%;overflow:clip;background:var(--paper-tief)}
  .play{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1.3rem;overflow:hidden}
  .play-text{font-family:var(--font-mono);font-size:28px;font-weight:400;color:hsl(0 0% 98%)}
  .schleier{position:absolute;inset:0;z-index:1;overflow:hidden}
  /* Eckwinkel wie auf der Live-Seite: dünne dunkle Linien, ca. 5px außerhalb des Bildes, Schenkel ca. 26px */
  .ecke{position:absolute;z-index:3;width:26px;height:26px;border-color:#6f6a60;border-style:solid;pointer-events:none}
  .ol{left:-6px;top:-6px;border-width:1px 0 0 1px}
  .ur{right:-6px;bottom:-6px;border-width:0 1px 1px 0}
  .marke{position:absolute;right:10px;bottom:10px;z-index:1;transform:rotate(180deg);transform-origin:50% 50%;font-size:10px;white-space:nowrap;writing-mode:vertical-rl}
  .marke span{font-family:var(--font-mono);color:#fff;line-height:1;font-weight:400;white-space:nowrap}
  /* testimonial53_lightbox */
  .rahmen{overflow:visible;padding:.25rem}
  .rahmen .bild{box-shadow:0 30px 60px 0 rgba(0,0,0,.2)}
  .vorschauvideo{position:absolute;inset:0;z-index:1;width:100%;height:100%;object-fit:cover;opacity:0;pointer-events:none}
  .vorschauvideo.an{opacity:1}
  .blende{position:absolute;inset:0;z-index:1;background:#000;opacity:0;pointer-events:none;transition:opacity .35s ease}
  .blende.an{opacity:1}
  @media (max-width:991px){.bild{height:100%}}
</style>
<script>
  // Video-Vorschau: Maus drauf → kurz schwarz, dann läuft das Video; Maus weg → über Schwarz zurück zum Deckbild.
  // Handy/Tablet (kein Darüberfahren) → läuft, sobald das Bild zu 60 % zu sehen ist.
  const ohneMaus = window.matchMedia('(hover: none)').matches;
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const warte = (ms: number) => new Promise((r) => setTimeout(r, ms));
  document.querySelectorAll<HTMLElement>('[data-vorschau]').forEach((el) => {
    const v = el.querySelector<HTMLVideoElement>('.vorschauvideo');
    const b = el.querySelector<HTMLElement>('.blende');
    if (!v || !b || ruhig) return;
    let lauf = 0;
    const start = async () => {
      const id = ++lauf;
      b.classList.add('an'); v.preload = 'auto';
      await warte(350); if (id !== lauf) return;
      v.currentTime = 0;
      try { await v.play(); } catch { b.classList.remove('an'); return; }
      if (id !== lauf) return;
      v.classList.add('an'); b.classList.remove('an');
    };
    const stopp = async () => {
      const id = ++lauf;
      if (!v.classList.contains('an')) { b.classList.remove('an'); return; }
      b.classList.add('an');
      await warte(350); if (id !== lauf) return;
      v.pause(); v.classList.remove('an'); b.classList.remove('an');
    };
    if (ohneMaus && 'IntersectionObserver' in window) {
      new IntersectionObserver((e) => e.forEach((x) => (x.isIntersecting ? start() : stopp())), { threshold: 0.6 }).observe(el);
    } else {
      el.addEventListener('mouseenter', start);
      el.addEventListener('mouseleave', stopp);
    }
  });
</script>

---
// Zeitstrahl der Referenzen – 1:1 nach Webflow (timeline13)
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Randhinweis from '../Randhinweis.astro';
import Referenzkarte from './Referenzkarte.astro';
import { bilder } from '../../data/bilder';
const eintraege = [
  { slug: 'rastatt', jahr: '2017', titel: 'Revitalisierung des Joffre-Areals in Rastatt', text: 'Aus den ehemaligen Mannschaftsunterkünften der „Bastion 30" wurde ein lebendiges Wohnquartier. Alle 112 Einheiten waren in nur sechs Monaten verkauft, 2019 fertiggestellt – ausgezeichnet für beispielhaftes Bauen in Baden.',
    karte: { titel: 'Joffre-Areal in Rastatt', text: 'Drei sanierte Denkmalhäuser, verbunden durch moderne Bauteile, mit Balkonblick ins Grüne – ein Quartier, das Historie und modernen Komfort vereint.', bild: bilder.refRastatt, ort: 'Rastatt' } },
  { slug: 'wilhelmshaven', jahr: '2018', titel: 'Revitalisierung des Marinebekleidungsamtes in Wilhelmshaven', text: 'Das ehemalige Kaiserliche Marinebekleidungsamt wurde in vier „Häuser" gegliedert und zu einem hochwertigen Wohnquartier saniert. Es entstanden 77 Wohnungen – vom 1-Zimmer-Apartment bis zur Maisonette. Der Vertrieb lief von Dezember 2018 bis April 2020, Ende 2022 war das Projekt fertiggestellt.',
    karte: { titel: 'Kaiserlofts in Wilhelmshaven', text: 'Nur 350 m vom Hafen und 3 km vom Südstrand entfernt, mitten in einem gewachsenen Wohngebiet – maritimes Flair trifft auf denkmalgeschützte Architektur.', bild: bilder.refWilhelmshaven, ort: 'Wilhelmshaven' } },
  { slug: 'emden', jahr: '2020', titel: 'Revitalisierung der Karl-von-Müller-Kaserne in Emden', text: 'Das Türmchengebäude der ehemaligen Karl-von-Müller-Kaserne von 1940 wurde mit viel Liebe zum Detail saniert. Es entstanden 45 Wohnungen mit Terrassen, großzügigen Balkonen und barrierefreiem Zugang per Aufzug. Der Verkauf erfolgte von Dezember 2021 bis Januar 2022.',
    karte: { titel: 'Das Türmchengebäude in Emden', text: 'Emden ist nicht nur Urlaubsort, sondern auch Standort eines der größten Automobilwerke Deutschlands – ein starker Arbeitsmarkt sichert die Nachfrage nach Wohnraum.', bild: bilder.refEmden, ort: 'Emden' } },
  { slug: 'koblenz', jahr: '2021', titel: 'Revitalisierung des Preußischen Lehrerinnenseminars in Koblenz', text: 'Das 1907/08 im Neorenaissance-Stil erbaute Königlich Preußische Lehrerinnenseminar wurde behutsam zu hochwertigem Wohnraum umgebaut. 62 Wohnungen wurden von September bis November 2021 verkauft und notariell beurkundet.',
    karte: { titel: 'Palais 3-Klang in Koblenz', text: 'Im Villenviertel Koblenz-Oberwerth direkt am Rhein gelegen – ein repräsentatives Baudenkmal mit Geschichte und erstklassiger Lage.', bild: bilder.refKoblenz, ort: 'Koblenz' } },
  { slug: 'pfungstadt-fabrik', jahr: '2024', titel: 'Revitalisierung der Seidelschen Fabrik in Pfungstadt', text: 'In der historischen Seidelschen Fabrik entstehen 26 großzügige Denkmalwohnungen. In unter sechs Monaten – von Juli bis Dezember 2024 – war das Projekt vollständig verkauft und befindet sich derzeit im Bau.',
    karte: { titel: 'Seidelsche Fabrik in Pfungstadt', text: 'Zentral im Rhein-Main-Gebiet, nur wenige Minuten von Darmstadt – mit Bahnhof und Einkauf vor der Tür und besonders großzügigen Wohnungen bis 170 m².', bild: bilder.refDarmstadt, ort: 'Pfungstadt' } },
];
---
<section class="sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="II." thema="Referenzen / Seit 2017" zaehler="02 / 02" />
    <div class="kopfraster">
      <div>
        <Tagline wort="Referenzen" nummer="02" />
        <h2 class="h1 abstand-header">Erfolgreich sanierte Denkmäler: unsere größten Referenzobjekte im Überblick</h2>
        <p class="text-normal">Kasernen, Ämter, Fabriken – viele unserer Häuser hatten ihr erstes Leben längst hinter sich. Hier sehen Sie, was daraus wurde: vollständig verkaufte, hochwertig sanierte Wohnquartiere, übergeben an zufriedene Eigentümer und Mieter.</p>
      </div>
      <div class="rechts"><Randhinweis nummer="01" titel="VERSPROCHEN & GEHALTEN" text="Jedes dieser Projekte wurde vollständig verkauft und fertiggestellt. Die Sanierungen haben wir in allen Bauphasen dokumentiert – überzeugen Sie sich selbst." /></div>
    </div>
    <div class="zeitstrahl" data-zeitstrahl>
      <div class="linie" aria-hidden="true"><span class="fortschritt"></span></div>
      <div class="liste">
        {eintraege.map((e, i) => (
          <div class:list={['reihe', { gespiegelt: i % 2 === 1 }]}>
            <div class="bild-spalte">
              <Referenzkarte href={`/referenzen-cms/${e.slug}`} nummer={`0${i + 1} / 05`} drehung={i % 2 === 1 ? '4deg' : '-3deg'} {...e.karte} />
            </div>
            <div class="punkt-spalte"><span class="punkt"></span></div>
            <div class="text-spalte">
              <div class="item">
                <p class="jahr">{e.jahr}</p>
                <h3 class="titel">{e.titel}</h3>
                <p class="text-normal text">{e.text}</p>
                <Button href={`/referenzen-cms/${e.slug}`} variante="sekundaer">Zum Referenzprojekt</Button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    <Kapitelfuss />
  </div>
</section>
<style>
  .kopfraster{display:grid;grid-template-columns:1fr .55fr;gap:5rem;align-items:start}
  .rechts{display:flex;justify-content:flex-end}
  .zeitstrahl{position:relative}
  .linie{position:absolute;top:0;bottom:0;left:50%;width:3px;margin-left:-1.5px;background:rgba(12,12,12,.15)}
  .fortschritt{position:absolute;top:0;left:0;width:3px;height:var(--fortschritt,0%);background:hsl(0 18.11% 34.43%)}
  .liste{display:grid;gap:5rem}
  .reihe{display:grid;grid-template-columns:1fr max-content 1fr;gap:1.6rem;padding:3rem 0}
  .gespiegelt .bild-spalte{order:3}
  .gespiegelt .text-spalte{order:1}
  .gespiegelt .punkt-spalte{order:2}
  .punkt-spalte{position:relative;z-index:1;display:flex;width:2rem;justify-content:center}
  .punkt{width:.9375rem;height:.9375rem;margin-top:2rem;border-radius:50%;background:rgba(0,0,0,.71)}
  .item{position:relative;z-index:2;padding-left:20%}
  .gespiegelt .item{padding-left:20%}
  .jahr{margin:0 0 1.5rem;font-family:var(--font-playfair);font-style:italic;font-weight:400;font-size:78px;line-height:66.3px;letter-spacing:-1.56px;color:var(--signal-orange)}
  .titel{margin:0 0 .5rem;max-width:19.3rem;font-family:var(--font-sans);color:#333;font-size:1.3rem;line-height:1.3;font-weight:700}
  .text{max-width:19.3rem;padding-bottom:1rem}
  .item :global(.btn){margin-top:.5rem}
  @media (max-width:991px){.kopfraster{grid-template-columns:1fr;gap:2rem}.rechts{justify-content:flex-start}.reihe{gap:2rem}}
  @media (max-width:767px){
    .linie{left:1rem}
    .reihe{grid-template-columns:max-content 1fr;gap:2rem 1rem}
    .punkt-spalte{grid-row:1 / span 2;order:0 !important}
    .text-spalte{grid-column:2;order:1 !important}
    .bild-spalte{grid-column:2;order:2 !important}
    .item,.gespiegelt .item{padding-left:0}
    .punkt{margin-top:1.75rem}
    .jahr{font-size:56px;line-height:50px}
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-zeitstrahl]').forEach((z) => {
    const aktualisiere = () => {
      const r = z.getBoundingClientRect();
      const wert = Math.max(0, Math.min(1, (innerHeight / 2 - r.top) / r.height));
      z.style.setProperty('--fortschritt', (wert * 100).toFixed(1) + '%');
    };
    addEventListener('scroll', aktualisiere, { passive: true });
    aktualisiere();
  });
</script>

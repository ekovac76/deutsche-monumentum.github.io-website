---
// Baustein „Kennzahlkarte“: Zahl oben links, Icon, Titel, Text, Pfeil-Kreis
interface Props { zahl: string; neben?: string; titel: string; text: string; href?: string; icon?: string }
import { bilder } from '../data/bilder';
const { zahl, neben, titel, text, href, icon = bilder.kennzahlIcon } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="karte" href={href}>
  <div class="oben">
    <span class="zahl">{zahl}</span>
    {neben && <span class="neben">{neben}</span>}
  </div>
  <img class="icon" src={icon} alt="" width="24" height="24" />
  <h3 class="h4">{titel}</h3>
  <p class="text-small">{text}</p>
  <span class="pfeil" aria-hidden="true"><img src={bilder.kennzahlPfeil} alt="" /></span>
</Tag>
<style>
  .karte{position:relative;display:flex;flex-direction:column;justify-content:flex-start;gap:.7rem;height:100%;padding:2rem 1rem;border:1px solid hsl(0 0% 73.33%);border-radius:var(--radius-kennzahl);background:var(--paper-tief);box-shadow:var(--shadow-kennzahl);text-decoration:none;color:inherit}
  .oben{display:flex;justify-content:space-between;align-items:flex-start}
  .zahl{font-style:italic;font-size:22px;line-height:34.1px;letter-spacing:.88px;color:var(--kennzahl-rot)}
  .neben{font-family:var(--font-mono);font-size:10px;line-height:14.73px;font-weight:500;letter-spacing:1.71px;text-transform:uppercase;color:var(--ink-stumpf)}
  .icon{width:1.5rem;height:1.5rem;object-fit:contain}
  .text-small{max-width:200px}
  .pfeil{position:absolute;right:1rem;bottom:1rem;display:flex;width:28px;height:28px;justify-content:center;align-items:center;border:1px solid rgba(21,20,15,.16);border-radius:14px}
</style>

---
// 5 Sterne in Malve (in Webflow die orange Grafik „Stars.svg“, 116 × 20 px)
const stern = 'M10 1.2l2.6 5.6 6.1.7-4.5 4.2 1.2 6.1L10 14.8l-5.4 3 1.2-6.1L1.3 7.5l6.1-.7z';
---
<svg class="sterne" width="116" height="20" viewBox="0 0 116 20" role="img" aria-label="5 von 5 Sternen">
  {[0, 1, 2, 3, 4].map((i) => <path d={stern} transform={`translate(${i * 24} 0)`} />)}
</svg>
<style>
  .sterne{display:block;fill:var(--malve)}
</style>

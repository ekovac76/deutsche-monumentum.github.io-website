---
// 5 Sterne – Original-Grafik „Stars.svg“ aus Webflow (überall gleich, 116 px breit wie dort dargestellt)
// Test (Eduard 06.11.): bei den Testfarben (html.hintergrund-bone) stattdessen gezeichnete Sterne in Malve
import { bilder } from '../data/bilder';
const stern = 'M10 1.2l2.6 5.6 6.1.7-4.5 4.2 1.2 6.1L10 14.8l-5.4 3 1.2-6.1L1.3 7.5l6.1-.7z';
---
<img class="sterne" src={bilder.sterne} alt="5 von 5 Sternen" width="116" height="20" />
<svg class="sterne-test" width="116" height="20" viewBox="0 0 116 20" role="img" aria-label="5 von 5 Sternen">
  {[0, 1, 2, 3, 4].map((i) => <path d={stern} transform={`translate(${i * 24} 0)`} />)}
</svg>
<style>
  .sterne{display:flex;width:116px;height:auto;max-width:none;object-fit:cover}
  .sterne-test{display:none;fill:#8e5d6e}
  :global(html.hintergrund-bone) .sterne{display:none}
  :global(html.hintergrund-bone) .sterne-test{display:block}
</style>

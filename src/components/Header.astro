---
// Kopfzeile + Menüfenster nach Baustein „Navigation“
// Animation 1:1 nach Flux-Academy-Video „GSAP Crash Course“ (Min. 3–9), mit GSAP:
// 1. Menüfenster: Größe 0,6 → 1 und von −150 % herabgleitend, Easing back.inOut, 0,6 s
// 2. Hamburger-Knopf dreht sich gleichzeitig 360° und wird zum X (gleiche Stelle)
// 3. Menüpunkte gleiten von unten mit Opacity ein, gestaffelt über 0,2 s
// Erneuter Klick spielt alles rückwärts. Inhalt linksbündig (statt mittig wie im Video).
import Button from './Button.astro';
import { menue } from '../data/navigation';
---
<header class="kopf">
  <div class="bar">
    <a href="/" aria-label="Deutsche Monumentum – Startseite">
      <img class="logo" src="/bilder/logo-deutsche-monumentum.png" alt="Deutsche Monumentum" width="160" height="44" />
    </a>
    <div class="rechts">
      <span class="kontakt-btn"><Button href="/#kontakt" variante="klein">Kontaktformular</Button></span>
      <button class="menu-btn" aria-label="Menü öffnen" aria-expanded="false" aria-controls="hauptmenue">
        <i></i><i></i><i></i>
      </button>
    </div>
  </div>
</header>

<div class="menue" id="hauptmenue" hidden>
  <div class="karte">
    <nav class="links" aria-label="Hauptmenü">
      <div class="liste">
        {menue.map((m, i) => (
          <a href={m.href}>
            <span class="ziffer" data-i={i}>{m.ziffer}</span>
            <span class="name" data-i={i}>{m.name}</span>
          </a>
        ))}
      </div>
    </nav>
  </div>
</div>

<style>
  /* wie Webflow (navbar16_component): fest oben, durchsichtig, leicht weichgezeichnet – Seitenkopf scheint durch */
  .kopf{position:fixed;top:0;left:0;right:0;z-index:50;background:hsla(0,0%,86.67%,0);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}
  /* Menü offen: Kopfzeile liegt über dem Fenster, damit der Knopf (jetzt X) an seiner Stelle bleibt */
  :global(body.menue-offen) .kopf{z-index:110;-webkit-backdrop-filter:none;backdrop-filter:none}
  .bar{display:flex;justify-content:space-between;align-items:center;min-height:var(--nav-height);padding:0 var(--page-gutter)}
  .logo{display:block;height:44px;width:auto}
  .rechts{display:flex;align-items:center;gap:var(--space-md)}
  .kontakt-btn{transition:opacity .3s ease}
  :global(body.menue-offen) .kontakt-btn{opacity:0;pointer-events:none}

  /* Hamburger → X */
  .menu-btn{position:relative;width:32px;height:32px;background:none;border:0;padding:0;cursor:pointer}
  .menu-btn i{position:absolute;left:4px;right:4px;top:15.25px;height:1.5px;background:var(--ink-tinte);transition:transform .6s cubic-bezier(.68,-.55,.27,1.55),opacity .3s ease}
  .menu-btn i:nth-child(1){transform:translateY(-6.25px)}
  .menu-btn i:nth-child(3){transform:translateY(6.25px)}
  .menu-btn[aria-expanded="true"] i:nth-child(1){transform:rotate(45deg)}
  .menu-btn[aria-expanded="true"] i:nth-child(2){opacity:0}
  .menu-btn[aria-expanded="true"] i:nth-child(3){transform:rotate(-45deg)}

  /* Menüfenster: Karte oben rechts, Knopf sitzt in ihrer Ecke; Ecken/Rand/Schatten wie Projektkarte */
  .menue{position:fixed;inset:0;z-index:100}
  /* Oberkante der Karte auf Höhe der Knopfmitte – das X steht wie der Stern im Video halb über dem Rand */
  .karte{position:absolute;top:calc(var(--nav-height) / 2);right:max(.5rem,calc(5vw + 16px - 2.25rem));width:min(44rem,calc(100vw - 1rem));max-height:calc(100vh - var(--nav-height) / 2 - .5rem);overflow-y:auto;
    display:flex;flex-direction:column;justify-content:center;padding:3rem;
    background:var(--paper-bone);border:1px solid hsl(0 0% 62%);border-radius:10px;box-shadow:var(--shadow-karte)}

  .links{display:flex;justify-content:flex-start}
  .liste{display:grid;grid-template-columns:auto auto;column-gap:.35em;font-size:clamp(2rem,3.2vw,2.9rem)}
  .liste a{display:contents;text-decoration:none}
  .ziffer{justify-self:end;align-self:baseline;font-family:var(--font-playfair);font-style:italic;font-weight:400;font-size:.7em;color:var(--signal-orange);padding:.3rem 0;margin:.3rem 0;line-height:1.2}
  .name{justify-self:start;align-self:baseline;font-family:var(--font-display);font-weight:700;line-height:1.2;color:var(--ink-stumpf);padding:.3rem 0;margin:.3rem 0;white-space:nowrap}

  @media (max-width: 767px){
    .kontakt-btn{display:none}
    .karte{width:calc(100vw - 1rem);right:.5rem;padding:2.5rem 1.5rem}
    .liste{font-size:2rem}
    .ziffer{margin:.2rem 0}
    .name{margin:.2rem 0;white-space:normal}
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(SplitText);

  const menue = document.getElementById('hauptmenue');
  const knopf = document.querySelector<HTMLButtonElement>('.menu-btn');
  const karte = menue?.querySelector<HTMLElement>('.karte');

  if (menue && knopf && karte) {
    const punkte = menue.querySelectorAll<HTMLElement>('[data-i]');
    const zeilen = Number(punkte[punkte.length - 1]?.dataset.i ?? 0);
    const leise = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Zeitleiste wie im Video
    const tl = gsap.timeline({
      paused: true,
      onReverseComplete: () => { menue.hidden = true; },
    });
    // 1. „Menu in“: Fenster von −150 % und Größe 0,6 auf Endstellung
    tl.fromTo(karte, { yPercent: -150, scale: 0.6 }, { yPercent: 0, scale: 1, duration: 0.6, ease: 'back.inOut' }, 0);
    // 2. Knopf dreht sich einmal ganz herum – gleichzeitig
    tl.fromTo(knopf, { rotation: 0 }, { rotation: 360, duration: 0.6, ease: 'back.inOut' }, 0);
    // 3. Menüpunkte: von unten mit Opacity, gestaffelt über insgesamt 0,2 s (Ziffer + Name einer Zeile gemeinsam)
    tl.fromTo(punkte, { yPercent: 100, opacity: 0 }, {
      yPercent: 0, opacity: 1, duration: 0.6, ease: 'back.inOut',
      stagger: (_i: number, el: HTMLElement) => (zeilen ? (Number(el.dataset.i) / zeilen) * 0.2 : 0),
    }, 0.2);

    let offen = false;
    function setze(neu: boolean) {
      if (neu === offen) return;
      offen = neu;
      knopf!.setAttribute('aria-expanded', String(offen));
      knopf!.setAttribute('aria-label', offen ? 'Menü schließen' : 'Menü öffnen');
      document.body.classList.toggle('menue-offen', offen);
      document.body.style.overflow = offen ? 'hidden' : '';
      if (offen) { menue!.hidden = false; leise ? tl.progress(1) : tl.play(); }
      else if (leise) { tl.progress(0); menue!.hidden = true; }
      else tl.reverse();
    }
    // Hover wie im Video (ab 15:44): Buchstaben des Namens wachsen auf 1,2 und werden leicht durchsichtig,
    // gestaffelt über 0,2 s; beim Verlassen läuft es rückwärts (etwas schneller)
    if (!leise && window.matchMedia('(hover: hover)').matches) {
      menue.querySelectorAll<HTMLAnchorElement>('.liste a').forEach((a) => {
        const name = a.querySelector<HTMLElement>('.name');
        if (!name) return;
        const teile = SplitText.create(name, { type: 'words,chars' });
        const hover = gsap.timeline({ paused: true })
          .fromTo(teile.chars, { scale: 1, opacity: 1 }, { scale: 1.2, opacity: 0.6, duration: 0.4, ease: 'power2.out', stagger: { amount: 0.2 } });
        a.addEventListener('mouseenter', () => hover.timeScale(1).play());
        a.addEventListener('mouseleave', () => hover.timeScale(1.5).reverse());
      });
    }
    knopf.addEventListener('click', () => setze(!offen));
    menue.addEventListener('click', (e) => { if (e.target === menue) setze(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setze(false); });
  }
</script>

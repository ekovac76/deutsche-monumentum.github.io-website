---
// Tabs „Wissen / im Video erklärt“: links Themen, rechts Video
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Randhinweis from '../Randhinweis.astro';
import Videovorschau from '../Videovorschau.astro';
import { bilder } from '../../data/bilder';
const themen = [
  ['Wie die Denkmalabschreibung funktioniert', 'Zwölf Jahre, zwei Stufen: Wie Sie die Sanierungskosten über 8 Jahre mit je 9 % und 4 Jahre mit je 7 % steuerlich geltend machen.'],
  ['Was das konkret für Sie bedeutet', 'Was die Abschreibung für Ihre persönliche Steuerlast bewirkt – anschaulich an einer Beispielrechnung erklärt.'],
  ['Die KfW-Förderung', 'Zinsgünstige Kredite und Tilgungszuschüsse: Wie die KfW-Förderung Ihre Finanzierung zusätzlich entlastet.'],
  ['Wie der Kauf abläuft', 'Vom ersten Gespräch bis zum Notartermin: die Schritte zum Kauf Ihrer Denkmalimmobilie im Überblick.'],
];
---
<section class="sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="X." thema="Wissen / Im Video erklärt" zaehler="10 / 10" />
    <div class="kopfraster">
      <div>
        <Tagline nummer="10" />
        <div class="abstand-header"><h2 class="h1 schmal">Alles, was Sie über Denkmalimmobilien wissen sollten – kurz erklärt im Video</h2></div>
        <p class="text-normal schmal">Kurz und verständlich erklärt: Denkmalimmobilien, Ihre Steuervorteile und wie die Zusammenarbeit mit Deutsche Monumentum abläuft.</p>
      </div>
      <div class="rechts"><Randhinweis text="Sie wollen tiefer einsteigen? Im persönlichen Gespräch rechnen wir Ihr Beispiel konkret durch." /></div>
    </div>
    <div class="tabs" data-tabs>
      <div class="menue" role="tablist">
        {themen.map(([titel, text], i) => (
          <button class:list={['tab', { aktiv: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
            <span class="kopf"><span class="nr">{String(i + 1).padStart(2, '0')}</span><span class="titel">{titel}</span></span>
            <span class="beschreibung">{text}</span>
          </button>
        ))}
      </div>
      <div class="inhalt">
        {themen.map(([titel], i) => (
          <div class="pane" role="tabpanel" data-pane={i} hidden={i !== 0}>
            <div class="pane-innen"><Videovorschau bild={bilder.eduardVideo} alt={titel} /></div>
          </div>
        ))}
      </div>
    </div>
    <Kapitelfuss />
  </div>
</section>
<style>
  /* 1:1 nach Webflow layout505 (Kopf wie Div Block 54/58, Tabs 1fr 1fr, Menü über Videohöhe verteilt) */
  .kopfraster{display:grid;grid-template-columns:1fr .8fr;gap:4rem}
  .rechts{display:flex;flex-direction:column;align-items:flex-start}
  .tabs{display:grid;grid-template-columns:1fr 1fr;gap:0;align-items:stretch}
  .menue{display:grid;grid-template-columns:1fr;grid-auto-rows:1fr;justify-items:start;height:100%;padding:1rem 0}
  .tab{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:0;border:0;background:none;text-align:left;cursor:pointer;font:inherit;color:hsl(0 0% 62.67%)}
  .tab.aktiv{color:var(--ink-tinte)}
  .kopf{display:flex;justify-content:center;align-items:center;gap:1rem}
  .nr{font-family:var(--font-mono);font-size:1.3rem;font-weight:400}
  .titel{font-family:var(--font-display);font-size:1.3rem;line-height:1.4;font-weight:700}
  .beschreibung{padding-left:2.6rem;font-family:var(--font-sans);font-size:1rem;line-height:1.5}
  .pane{height:100%}
  .pane-innen{display:flex;flex-direction:column;justify-content:center;height:100%;padding:0 4rem}
  @media (min-width:1280px){
    .kopfraster{grid-template-columns:1fr .6fr}
    .schmal{max-width:35rem}
    .menue{padding:2rem 0 2rem 4rem}
    .tab{max-width:30rem}
  }
  @media (max-width:991px){.titel{font-size:1rem}.beschreibung{font-size:.8rem}.pane-innen{padding:2rem}}
  @media (max-width:767px){
    .kopfraster{grid-template-columns:1fr}
    .tabs{grid-template-columns:1fr}
    .menue{grid-auto-rows:auto}
    .tab{padding:0 1.5rem}
    .titel{font-size:1.25rem}
    .beschreibung{font-size:.9rem}
    .pane-innen{padding:1.5rem}
  }
  @media (max-width:479px){.sektion-innen{gap:2rem}.kopfraster{gap:2rem}.tab{padding-bottom:1rem}.titel{font-size:1rem}.beschreibung{font-size:.8rem}}
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const tabs = box.querySelectorAll<HTMLElement>('[data-tab]');
    const panes = box.querySelectorAll<HTMLElement>('[data-pane]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { x.classList.toggle('aktiv', x === t); x.setAttribute('aria-selected', String(x === t)); });
      panes.forEach((p) => { p.hidden = p.dataset.pane !== t.dataset.tab; });
    }));
  });
</script>

---
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Kennzahlkarte from '../Kennzahlkarte.astro';
import { seite } from '../../data/cms';
const s = seite('teamseite').leistungen;
---
<section class="sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="III." thema={s.thema} zaehler="03 / 05" />
    <div class="raster">
      <div>
        <Tagline wort={s.tagline} nummer="03" />
        <div class="abstand-header"><h2 class="h1 schmal">{s.ueberschrift}</h2></div>
      </div>
      <div class="rechts">
        <p class="text-normal abstand-text">{s.text}</p>
        <div class="button-zeile knopf-abstand"><Button href="#kontakt" data-kontakt>{s.knopf}</Button></div>
      </div>
    </div>
    <div class="karten">
      {s.kacheln.map((k) => <Kennzahlkarte zahl={k.zahl} neben={k.label} titel={k.titel} text={k.text} icon={k.icon} vorteil schmalerTitel />)}
    </div>
    <Kapitelfuss />
  </div>
</section>
<style>
  /* 1:1 nach Webflow layout245 + Div Block 46 (wie Projekte-Vorteile): 4/3/2/1 Kacheln */
  .sektion-innen{gap:2rem}
  .raster{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start}
  .rechts{width:80%}
  .knopf-abstand{padding-bottom:3rem}
  .karten{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
  /* Bold Text 15: 2,8rem / 3,6rem, #333. Div Block 56 = 29,5rem; auf dem Mac läuft die Schrift minimal breiter, daher 28,5rem für denselben Umbruch */
  .schmal{line-height:3.6rem;color:#333}
  @media (min-width:1280px){.raster{grid-template-columns:1fr .75fr}.schmal{max-width:28.5rem}.karten{grid-template-columns:repeat(4,1fr)}}
  @media (max-width:991px){.raster{grid-template-columns:1fr;gap:2rem}.karten{grid-template-columns:1fr 1fr}}
  @media (max-width:767px){.raster{gap:1.25rem}}
  @media (max-width:991px){.schmal{font-size:2.9rem;line-height:3.4rem}}
  @media (max-width:767px){.schmal{font-size:2.5rem;line-height:2.8rem}}
  @media (max-width:479px){.schmal{font-size:2rem;line-height:2.4rem}.sektion-innen{gap:3rem}.karten{grid-template-columns:1fr}}
</style>

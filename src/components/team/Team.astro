---
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Randhinweis from '../Randhinweis.astro';
import Teamkarte from './Teamkarte.astro';
import { seite } from '../../data/cms';
const s = seite('teamseite').team;
---
<section class="sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="II." thema={s.thema} zaehler="02 / 05" />
    <div class="kopfraster">
      <div>
        <Tagline wort={s.tagline} nummer="02" />
        <h2 class="h1 abstand-header">{s.ueberschrift}</h2>
      </div>
      <div class="rechts"><Randhinweis nummer="01" titel={s.hinweisTitel} text={s.hinweisText} /></div>
    </div>
    <div class="liste">
      {s.mitglieder.map((m) => <Teamkarte bild={m.bild} rolle={m.rolle} nummer={m.nummer} name={m.name} text={m.text} jahr={s.jahr} />)}
    </div>
    <Kapitelfuss />
  </div>
</section>
<style>
  .kopfraster{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .rechts{display:flex;flex-direction:column;align-items:flex-end}
  .liste{display:grid;grid-template-columns:repeat(4,1fr);gap:4rem 2rem}
  @media (max-width:991px){.liste{grid-template-columns:repeat(3,1fr)}}
  @media (max-width:767px){.kopfraster{grid-template-columns:1fr}.rechts{align-items:flex-start}.liste{gap:3rem 2rem}}
  @media (max-width:479px){.liste{grid-template-columns:1fr 1fr}}
</style>

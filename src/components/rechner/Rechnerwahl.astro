---
// Berechnungstool · Auswahl der Kalkulatoren (Webflow: section_layout11)
import Button from '../Button.astro';
import Tagline from '../Tagline.astro';
import Kapitelkopf from '../Kapitelkopf.astro';
import Kapitelfuss from '../Kapitelfuss.astro';
import Videovorschau from '../Videovorschau.astro';
import { seite } from '../../data/cms';
const s = seite('rechnerseite').rechner;
---
<section class="sektion">
  <div class="sektion-innen">
    <Kapitelkopf ziffer="V." thema={s.thema} zaehler="05 / 10" />
    <div class="inhalt">
      <div>
        <Tagline wort={s.tagline} nummer="04" />
        <p class="h3 abstand-header">{s.zitat}</p>
        <p class="text-normal abstand-text">{s.text}</p>
        <div class="liste">
          {s.rechner.map((r) => (
            <div>
              <div class="klein"><img class="icon" src={r.icon} alt="" width="48" height="48" loading="lazy" /></div>
              <div class="klein"><h3 class="h4">{r.titel}</h3></div>
              <div class="klein"><p class="text-small">{r.text}</p></div>
              <div class="button-zeile"><Button href={r.link} variante="sekundaer">{r.titel}</Button></div>
            </div>
          ))}
        </div>
      </div>
      <Videovorschau bild={s.bild} video={s.videoLink} alt="Video" />
    </div>
    <Kapitelfuss />
  </div>
</section>
<style>
  .inhalt{display:grid;grid-template-columns:1fr 1fr;gap:4rem 5rem;align-items:center}
  .liste{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;padding:.5rem 0}
  .klein{padding-bottom:1rem}
  .icon{width:3rem;height:3rem}
  @media (max-width:991px){.inhalt{gap:4rem 3rem}}
  @media (max-width:767px){.inhalt{grid-template-columns:1fr;gap:3rem}}
  @media (max-width:479px){.liste{grid-template-columns:1fr}}
</style>
